	chapter.762061B95D980973.title: "Explorer's Path"
	quest.152CDDD79B386829.quest_desc: [
		"&7&oThe World notes that you have left the first door behind.&r"
		"&6Field note:&r Perk: 600 claimable chunks, 30 force-loaded, /back cooldown 25 s."
	]
	quest.152CDDD79B386829.title: "Wayfarer"
	quest.1BFEDD39F1856BD0.quest_desc: [
		"&7&oThe World finds you in a place where time keeps its own counsel.&r"
		"&6Field note:&r Perk: 1100 claimable chunks, 50 force-loaded, /back cooldown 10 s."
	]
	quest.1BFEDD39F1856BD0.title: "Wanderer of Ages"
	quest.38C133B7697D224A.quest_desc: [
		"&7&oThere is a deepest place in every world. The World has noted that you have gone there.&r"
		"&6Field note:&r Perk: 1400 claimable chunks, 60 force-loaded, /back cooldown 5 s."
	]
	quest.38C133B7697D224A.title: "World Walker"
	quest.4304753007281757.quest_desc: ["&7&oTravel the long way, the short way.&r"]
	quest.4304753007281757.title: "Subspace Bubble"
	quest.4848E611462C25F5.quest_desc: ["&7&oThere is a map in the sky, if you know how to throw.&r"]
	quest.4848E611462C25F5.title: "Eye Spy"
	quest.4B31678B901839B3.quest_desc: ["&7&oThe world is bigger than you think. Prove it.&r"]
	quest.4B31678B901839B3.title: "Adventuring Time"
	quest.65DF398FA298D531.quest_desc: [
		"&7&oA forest between worlds has learned your name.&r"
		"&6Field note:&r Perk: 750 claimable chunks, 35 force-loaded, /back cooldown 20 s."
	]
	quest.65DF398FA298D531.title: "Pathfinder"
	quest.6FB1984671830986.quest_desc: ["&7&oSome ground is only ground if you step lightly.&r"]
	quest.6FB1984671830986.title: "Light as a Rabbit"
	quest.73DC79C10D4B4EB8.quest_desc: [
		"&7&oThe sky overhead has changed to something you cannot yet name.&r"
		"&6Field note:&r Perk: 900 claimable chunks, 40 force-loaded, /back cooldown 15 s."
	]
	quest.73DC79C10D4B4EB8.title: "Trailblazer"
	quest.75CBE2ED91D89435.quest_desc: ["&7&oYou have seen every kind of hot there is.&r"]
	quest.75CBE2ED91D89435.title: "Hot Tourist Destinations"
	task.07BDFF55C58B04E9.title: "Walk beneath a different sky"
	task.09C3AF0CF17F1808.title: "Follow an eye of ender"
	task.1628FAC9BF030B4E.title: "Walk on powder snow in leather boots"
	task.1B1CAA7338DB7B5F.title: "Travel far in the overworld by way of the nether"
	task.3DA76C9AD9F4838B.title: "Step into the nether"
	task.4A57D2AD2ACEB9AC.title: "Step into the twilight"
	task.4CDB814593B1487F.title: "Reach the deepest water of the starlit world"
	task.54E7B42EF7C9F734.title: "Cross into a world held still"
	task.6CE4CCA84F8DB1A5.title: "Discover every biome"
	task.71BCC70DB58DDACD.title: "Explore every biome of the nether"
	chapter.1194D01643BF7B81.title: "Hunter's Path"
	quest.0FB1ACADEF10902E.quest_desc: [
		"&7&oA thing of iron and old grudges has fallen to you.&r"
		"&6Field note:&r Perk: +10% maximum health (stacks to +20%)."
	]
	quest.0FB1ACADEF10902E.title: "Stalker"
	quest.34D4605E99F65F5F.quest_desc: ["&7&oSomething grows when something dies here.&r"]
	quest.34D4605E99F65F5F.title: "It Spreads"
	quest.407186C76C70DEA0.quest_desc: [
		"&7&oSomething from beneath the sea has left the sea.&r"
		"&6Field note:&r Perk: +10% maximum health (stacks to +40%)."
	]
	quest.407186C76C70DEA0.title: "Dread Hunter"
	quest.45050C32E0DEE300.quest_desc: [
		"&7&oThe many-headed has stopped arguing with itself.&r"
		"&6Field note:&r Perk: +10% maximum health (stacks to +30%)."
	]
	quest.45050C32E0DEE300.title: "Slayer"
	quest.4A288F84E0AE9D62.quest_desc: [
		"&7&oNothing in this world is left that was waiting for you.&r"
		"&6Field note:&r Perk: +10% maximum health (stacks to +50%)."
	]
	quest.4A288F84E0AE9D62.title: "Apex Hunter"
	quest.4AE888FC4E3F53B5.quest_desc: ["&7&oA very long way, and a very small target.&r"]
	quest.4AE888FC4E3F53B5.title: "Sniper Duel"
	quest.5F04E440540817F6.quest_desc: ["&7&oSome deaths have a flair for the dramatic.&r"]
	quest.5F04E440540817F6.title: "Very Very Frightening"
	quest.5FBDD8637790F14D.quest_desc: ["&7&oA small circle, from a long way off.&r"]
	quest.5FBDD8637790F14D.title: "Bullseye"
	quest.615444BE1D167286.quest_desc: ["&7&oEfficiency is its own reward.&r"]
	quest.615444BE1D167286.title: "Two Birds, One Arrow"
	quest.6D812CFB14E7328A.quest_desc: [
		"&7&oThe World has watched you do your first killing. It does not judge.&r"
		"&6Field note:&r Perk: +10% maximum health."
	]
	quest.6D812CFB14E7328A.title: "Initiate Hunter"
	task.01AE8C879C2D9EC3.title: "Hit the centre of a target from a distance"
	task.23C23B181E7338CD.title: "Strike a villager with lightning"
	task.23C6A59588FC517A.title: "Call the leviathan and face it"
	task.2F04D1D55F5E6B97.title: "Pierce two phantoms with one arrow"
	task.3459A8D43D2399D8.title: "Reach the summit of ruin"
	task.3E5A78485B4DF123.title: "Fell the iron guardian"
	task.41883017500D9DF7.title: "Land a very long shot on a skeleton"
	task.585DC25CE4338FB6.title: "Kill a mob near a sculk catalyst"
	task.6E71A8DF632023F5.title: "Slay a hostile creature"
	task.6F6970935B11145D.title: "End the many-headed thing"
	chapter.2733028586FDD2F1.title: "Homesteader's Path"
	quest.0060761A38C8D45D.quest_desc: [
		"&7&oSomething green is growing in standing water.&r"
		"&6Field note:&r Perk: 3 homes, /home cooldown 6 s."
	]
	quest.0060761A38C8D45D.title: "Hearthkeeper"
	quest.0DD5EED250D4BF78.quest_desc: ["&7&oSome homes are better carried than built.&r"]
	quest.0DD5EED250D4BF78.title: "Total Beelocation"
	quest.167A402A23BB1156.quest_desc: [
		"&7&oEvery green thing a household could want, grown by your own hand.&r"
		"&6Field note:&r Perk: 6 homes, /home cooldown 2 s."
	]
	quest.167A402A23BB1156.title: "Provider"
	quest.21C9265606D140BF.quest_desc: ["&7&oPatience, a line, and a good reason.&r"]
	quest.21C9265606D140BF.title: "Fishy Business"
	quest.30F145686C6A57D7.quest_desc: ["&7&oEverything edible, once, to be fair.&r"]
	quest.30F145686C6A57D7.title: "A Balanced Diet"
	quest.4B0377CF2675DAC1.quest_desc: ["&7&oEvery home is better with a heartbeat.&r"]
	quest.4B0377CF2675DAC1.title: "Best Friends Forever"
	quest.53B4159C2CC709AA.quest_desc: [
		"&7&oThe World has eaten at your table and has nothing left to ask.&r"
		"&6Field note:&r Perk: 8 homes, /home cooldown 1 s."
	]
	quest.53B4159C2CC709AA.title: "Master of the House"
	quest.5434C0836376290D.quest_desc: ["&7&oA farm needs more than crops.&r"]
	quest.5434C0836376290D.title: "The Parrots and the Bees"
	quest.6E94D14A2F38539D.quest_desc: [
		"&7&oThere is enough here for more than one mouth.&r"
		"&6Field note:&r Perk: 4 homes, /home cooldown 4 s."
	]
	quest.6E94D14A2F38539D.title: "Steward"
	quest.7DE5FE1012AE1F03.quest_desc: [
		"&7&oThe World has noticed a pot on a fire, and a person who means to stay.&r"
		"&6Field note:&r Perk: 2 homes, /home cooldown 8 s."
	]
	quest.7DE5FE1012AE1F03.title: "Settler"
