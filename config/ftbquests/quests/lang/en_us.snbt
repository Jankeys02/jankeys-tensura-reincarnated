	quest.0061FC4FAC341B1B.quest_desc: [
		"&7&oThe small things you will do a thousand times.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"key.backpacked.open_backpack\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" opens your backpack, \"},{\"keybind\":\"key.curios.open.desc\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" the accessory (Curios) inventory and \"},{\"keybind\":\"key.manas_cosmetics.open_wardrobe\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" the cosmetics wardrobe. \"},{\"keybind\":\"gui.xaero_open_map\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" opens the world map and \"},{\"keybind\":\"gui.xaero_new_waypoint\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" drops a waypoint. In a recipe viewer, hover an item and press \"},{\"keybind\":\"key.jei.showRecipe\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" for how to make it or \"},{\"keybind\":\"key.jei.showUses\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" for what it is used in.\"}]}"
	]
	quest.0061FC4FAC341B1B.title: "Everyday Keys"
	quest.043CB502A26789AA.quest_desc: [
		"&7&oNot every fight needs to be won where you are standing.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"tensura.keybinding.dodge\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" dodges (marked experimental). While riding, the same key is how you climb down.\"}]}"
	]
	quest.043CB502A26789AA.title: "Step Aside"
	quest.10C654DFD5E1BB92.quest_desc: [
		"&7&oThere is something inside you that has opinions, and it is usually right.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"key.greatsage.menu\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" opens the Great Sage. \"},{\"keybind\":\"key.greatsage.assess\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" toggles Assess mode, \"},{\"keybind\":\"key.greatsage.scan\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" locks onto and scans a target, \"},{\"keybind\":\"key.greatsage.voice\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" speaks to it, and \"},{\"keybind\":\"key.greatsage.panic\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" stops it if it misbehaves. If two mods share a key, neither fires: rebind one in Controls.\"}]}"
	]
	quest.10C654DFD5E1BB92.title: "A Voice That Answers"
	quest.1A8E2FF4C7EA54D9.quest_desc: [
		"&7&oThe World speaks in short sentences. You are expected to listen.&r"
		"&6Field note:&r The keys shown in yellow below are YOUR current bindings. Change any of them in Options > Controls (look for the Tensura:Reincarnated group) and this guide follows."
	]
	quest.1A8E2FF4C7EA54D9.title: "The World Speaks"
	quest.1D7AE11A41D8336F.quest_desc: [
		"&7&oThe same skill can be held in more than one way.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"tensura.keybinding.next_mode\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" switches to the next ability mode. \\\"Previous Ability Mode\\\" (\"},{\"keybind\":\"tensura.keybinding.previous_mode\",\"color\":\"yellow\",\"bold\":true},{\"text\":\") is unbound by default, so set a key for it in Controls if you want it.\"}]}"
	]
	quest.1D7AE11A41D8336F.title: "Change Your Grip"
	quest.1FE93AD4E338D145.quest_desc: [
		"&7&oSome armour is not content to stand there.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" Cataclysm gear has its own keys: \"},{\"keybind\":\"key.cataclysm.ability\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" (weapon), \"},{\"keybind\":\"key.cataclysm.boots_ability\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" (boots), \"},{\"keybind\":\"key.cataclysm.helmet_ability\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" (helmet) and \"},{\"keybind\":\"key.cataclysm.chestplate_ability\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" (chestplate). Hold or wear the item first.\"}]}"
	]
	quest.1FE93AD4E338D145.title: "Gear That Answers"
	quest.26A1ACBCD6FF112D.quest_desc: [
		"&7&oA tool, a tree, and a very good idea.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" Hold \"},{\"keybind\":\"key.ftbultimine\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" and break a block to mine the whole vein. Hold Shift and scroll to change the shape. Your Miner's Path ranks raise how many blocks you can take at once.\"}]}"
	]
	quest.26A1ACBCD6FF112D.title: "Many Blocks, One Swing"
	quest.272ADC6FA03E327D.quest_desc: [
		"&7&oA name is a very large thing to give.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"tensura.keybinding.name\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" is Naming. It costs magicules, so check your reserves in the Status Menu first.\"}]}"
	]
	quest.272ADC6FA03E327D.title: "Give It a Name"
	quest.27D67684A56842C5.quest_desc: [
		"&7&oOthers are watching. Some of them have names that mean something.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"manas_ascendance.keybinding.main_gui\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" opens the Manas:Ascendance menu: Demon Lords, Heroes, challenges, factions and reputation. \"},{\"keybind\":\"key.elitetensura.open_council\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" opens the Council screen (Elite Tensura).\"}]}"
	]
	quest.27D67684A56842C5.title: "The Council"
	quest.58FC6FE93B250F71.quest_desc: [
		"&7&oThis book can be read faster than it looks.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" Open it with \"},{\"keybind\":\"key.ftbquests.quests\",\"color\":\"yellow\",\"bold\":true},{\"text\":\". \"},{\"keybind\":\"key.ftbquests.gui.next_chapter\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" and \"},{\"keybind\":\"key.ftbquests.gui.prev_chapter\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" switch chapters, \"},{\"keybind\":\"key.ftbquests.gui.search\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" searches, \"},{\"keybind\":\"key.ftbquests.gui.recenter\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" recentres the page, \"},{\"keybind\":\"key.ftbquests.gui.zoom_in\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" and \"},{\"keybind\":\"key.ftbquests.gui.zoom_out\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" zoom, and \"},{\"keybind\":\"key.ftbquests.gui.extended_info\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" shows extra detail.\"}]}"
	]
	quest.58FC6FE93B250F71.title: "Reading the Book"
	quest.590A2645FC47A8E3.quest_desc: [
		"&7&oSome weapons have a second voice.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" Weapon Deep Slots F, G and H (Tensura Nightmares) are \"},{\"keybind\":\"nightmareutils.keybinding.ability.deep_slot_a\",\"color\":\"yellow\",\"bold\":true},{\"text\":\", \"},{\"keybind\":\"nightmareutils.keybinding.ability.deep_slot_b\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" and \"},{\"keybind\":\"nightmareutils.keybinding.ability.deep_slot_c\",\"color\":\"yellow\",\"bold\":true},{\"text\":\".\"}]}"
	]
	quest.590A2645FC47A8E3.title: "Deeper Slots"
	quest.5F86A364666229AB.quest_desc: [
		"&7&oSkills are only useful if you can reach them.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"tensura.keybinding.ability.slot_1\",\"color\":\"yellow\",\"bold\":true},{\"text\":\", \"},{\"keybind\":\"tensura.keybinding.ability.slot_2\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" and \"},{\"keybind\":\"tensura.keybinding.ability.slot_3\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" fire the skills in ability slots 1, 2 and 3. Set which skill sits in which slot from the Status Menu.\"}]}"
	]
	quest.5F86A364666229AB.title: "Three Hands"
	quest.695DB53BF65D640E.quest_desc: [
		"&7&oEvery species carries one thing the others forgot.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"tensura.keybinding.race_ability\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" uses your Race ability, the special power of your species. If you are riding something, the same key uses the mount's ability instead.\"}]}"
	]
	quest.695DB53BF65D640E.title: "What Your Blood Remembers"
	quest.7D149BD83386632E.quest_desc: [
		"&7&oBefore anything else, ask what you are.&r"
		"{\"text\":\"\",\"extra\":[{\"text\":\"Field note:\",\"color\":\"gold\"},{\"text\":\" \"},{\"keybind\":\"tensura.keybinding.main_gui\",\"color\":\"yellow\",\"bold\":true},{\"text\":\" opens the Status Menu: your race, skills, stats and resistances.\"}]}"
	]
	quest.7D149BD83386632E.title: "Know Yourself"
