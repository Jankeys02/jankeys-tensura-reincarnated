	quest.39A7AA09A7F5D72A.quest_desc: [
		"You were reborn into a world of magic and monsters. This book is your guide."
		""
		"&6Key controls&r (they follow your own key bindings):"
		"{\"text\": \"\", \"extra\": [\"- Tensura menu (race, skills, evolution): \", {\"keybind\": \"tensura.keybinding.main_gui\", \"color\": \"yellow\"}]}"
		"{\"text\": \"\", \"extra\": [\"- Race ability: \", {\"keybind\": \"tensura.keybinding.race_ability\", \"color\": \"yellow\"}, \"   Dodge: \", {\"keybind\": \"tensura.keybinding.dodge\", \"color\": \"yellow\"}]}"
		"{\"text\": \"\", \"extra\": [\"- Ability slots: \", {\"keybind\": \"tensura.keybinding.ability.slot_1\", \"color\": \"yellow\"}, \" / \", {\"keybind\": \"tensura.keybinding.ability.slot_2\", \"color\": \"yellow\"}, \" / \", {\"keybind\": \"tensura.keybinding.ability.slot_3\", \"color\": \"yellow\"}, \"   switch mode: \", {\"keybind\": \"tensura.keybinding.next_mode\", \"color\": \"yellow\"}]}"
		"{\"text\": \"\", \"extra\": [\"- Great Sage menu: \", {\"keybind\": \"key.greatsage.menu\", \"color\": \"yellow\"}, \"   World map: \", {\"keybind\": \"gui.xaero_open_map\", \"color\": \"yellow\"}]}"
		"{\"text\": \"\", \"extra\": [\"- Backpack: \", {\"keybind\": \"key.backpacked.open_backpack\", \"color\": \"yellow\"}, \"   Vein-mine (hold): \", {\"keybind\": \"key.ftbultimine\", \"color\": \"yellow\"}]}"
		""
		"&7Recipes: hover an item and press R (recipe) or U (uses) in JEI.&r"
		"Tick the box to begin."
	]
