	quest.05958DECD5301907.title: "Not a Shulker"
	quest.06FE42BB7522628E.quest_desc: ["&7&oForged in a place that had run out of reasons.&r"]
	quest.06FE42BB7522628E.title: "The Broken Nether's Warmachine"
	quest.0D9A5398FDB2A2F1.quest_desc: ["&7&oA body that could not decide whether to burn or to stay.&r"]
	quest.0D9A5398FDB2A2F1.title: "Imperfect Thing"
	quest.10C24271EC9780BE.quest_desc: [
		"&7&oSand hides what the sun cannot.&r"
		"&6Field note:&r Suspicious sand inside is worth excavating."
	]
	quest.10C24271EC9780BE.title: "A Pyramid with Ideas"
	quest.12A0C0DD952B6A5E.quest_desc: ["&7&oIt was asleep. Someone should have left it that way.&r"]
	quest.12A0C0DD952B6A5E.title: "The Thing of an Ancient Civilization"
	quest.14A90A725D236AE5.quest_desc: ["&7&oSomeone built a stage for a very large audience.&r"]
	quest.14A90A725D236AE5.title: "A Massive Arena"
	quest.15320084450FE8D3.quest_desc: ["&7&oThe sea is the shallowest thing it has been in.&r"]
	quest.15320084450FE8D3.title: "A Multidimensional Predator"
	quest.155E13F7E0DFB1E8.quest_desc: ["&7&oA forge. Not for swords.&r"]
	quest.155E13F7E0DFB1E8.title: "Where the Monstrous Are Forged"
	quest.1E78BC758DCDC541.quest_desc: ["&7&oSmall claws are for ankles. These are not small.&r"]
	quest.1E78BC758DCDC541.title: "Not So Shrimple Now"
	quest.22AE4E1C1D676267.quest_desc: ["&7&oA fortress of black stone where one fortress was enough.&r"]
	quest.22AE4E1C1D676267.title: "Another Stronghold?!"
	quest.2637C6DC6DC8104C.quest_desc: ["&7&oYou have walked through every ending this world was saving.&r"]
	quest.2637C6DC6DC8104C.title: "The Cataclysmfarer"
	quest.2A7A35CF1F21EB67.quest_desc: ["&7&oA queen of storms, and a long way from home.&r"]
	quest.2A7A35CF1F21EB67.title: "The Calm After the Storm"
	quest.3650531B8E3ABBF7.quest_desc: ["&7&oMetal and gears, where only stone and trees belong.&r"]
	quest.3650531B8E3ABBF7.title: "Out-of-Place"
	quest.3E7AEEBFB393FBF9.quest_desc: ["&7&oThe desert keeps its own accounts.&r"]
	quest.3E7AEEBFB393FBF9.title: "Sands and Deserters"
	quest.3EF2F63BC607DACD.quest_desc: ["&7&oUnder the waves, a city that kept its streets.&r"]
	quest.3EF2F63BC607DACD.title: "Sunken in the Sea"
	quest.4F1999F7E5E7810F.quest_desc: ["&7&oSomeone thought the clouds needed a temple.&r"]
	quest.4F1999F7E5E7810F.title: "Why in the Sky?"
	quest.585E3AA7CB13EB4E.quest_desc: [
		"&7&oBefore the great things woke, small things fell. Their ruins remember.&r"
		"&6Field note:&r Ruins like these hold chests and hints. Explore carefully, they are not empty."
	]
	quest.585E3AA7CB13EB4E.title: "Whispers of Ruin"
	quest.5B730E53CB98ED39.quest_desc: ["&7&oIt is easier to wake a fire than to put it out.&r"]
	quest.5B730E53CB98ED39.title: "The Extinguished Fire"
	quest.6176AA88177FE152.quest_desc: ["&7&oA priest of something that did not deserve one.&r"]
	quest.6176AA88177FE152.title: "Crusade Against Curse"
	quest.61CAE340FC277D82.quest_desc: ["&7&oSomething bright is growing where something bright should not.&r"]
	quest.61CAE340FC277D82.title: "A Nest of Crystal"
	quest.655C58CE98ECA774.quest_desc: ["&7&oDig where the sand is wrong.&r"]
	quest.655C58CE98ECA774.title: "Death Finds a Way"
	quest.7235F1ECB34F2D18.quest_desc: ["&7&oA prison in the ice, and no one to blame for it.&r"]
