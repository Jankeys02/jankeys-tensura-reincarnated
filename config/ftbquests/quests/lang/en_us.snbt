	quest.42DA7BBF36640626.title: "Dragon Factor: Frost"
	quest.43D35AEBE27CE0B0.quest_desc: [
		"&7&oThe Creator left one door unlocked, for one kind of being.&r"
		"&6Field note:&r The intrinsic power given by the Creator God to manipulate the laws of the world as you see fit."
	]
	quest.43D35AEBE27CE0B0.title: "The Authority to Rewrite"
	quest.4647BFCCD6DE9E25.quest_desc: [
		"&7&oThe first to be called holy.&r"
