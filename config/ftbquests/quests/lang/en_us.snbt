	quest.01D763B7E4CFC7FB.quest_desc: ["&7&oCold light on dark water, stacked toward a ceiling you cannot see.&r"]
	quest.01D763B7E4CFC7FB.title: "Under the Prismarine"
	quest.15FF48EB80FFC23A.quest_desc: ["&7&oThere are three more.&r"]
	quest.15FF48EB80FFC23A.title: "Light, Dark, and the Gaps Between"
	quest.1BF2DADA5BC6BF96.quest_desc: ["&7&oHeavy and light, side by side.&r"]
	quest.1BF2DADA5BC6BF96.title: "Stone and Breath"
	quest.27ABDE5791F19FD1.quest_desc: ["&7&oThere is a darker dark, and it is still here.&r"]
	quest.27ABDE5791F19FD1.title: "The Deep Afterdark"
	quest.2B61DB5DEFD4CD80.quest_desc: [
		"&7&oThe magicians left their keys in strange places.&r"
		"&6Field note:&r Catalysts turn up in chests: mineshafts, ancient cities, buried treasure, end cities, ruined portals and nether bridges."
	]
	quest.2B61DB5DEFD4CD80.title: "Something to Offer"
	quest.2D58509DCA15C113.quest_desc: ["&7&oThe ground has opinions about being walked on.&r"]
	quest.2D58509DCA15C113.title: "White Stone, Dripping Stone"
	quest.2DC0C825F02AC0B5.quest_desc: [
		"&7&oYou were told there was nothing below the deep dark. You were told wrong.&r"
		"&6Field note:&r One catalyst charges the shrine for several trips, and the way back needs none."
	]
	quest.2DC0C825F02AC0B5.title: "Into the Afterdark"
	quest.33FFB174A93E4409.quest_desc: ["&7&oSome worlds are not reached by walking.&r"]
	quest.33FFB174A93E4409.title: "A World Made of Elements"
	quest.344C1B2385391B6D.quest_desc: ["&7&oIt is folded, and you are on the inside.&r"]
	quest.344C1B2385391B6D.title: "The World Behind the World"
	quest.35CE8CB6AD81AE94.quest_desc: ["&7&oThe keeper of the mausoleum does not like visitors who stay.&r"]
	quest.35CE8CB6AD81AE94.title: "A Crown of Bone"
	quest.3E01435D8BBE7404.quest_desc: ["&7&oTwo ways to be forgotten.&r"]
	quest.3E01435D8BBE7404.title: "Cold and Dry"
	quest.54DC79943FEF7A67.quest_desc: ["&7&oThey are not hungry. They just do not stop.&r"]
	quest.54DC79943FEF7A67.title: "The Restless Dead"
	quest.5CABFF21AD353522.quest_desc: ["&7&oGreen things, glowing, in a place that has never known day.&r"]
	quest.5CABFF21AD353522.title: "A Garden Where No Sun Reaches"
	quest.6B22D9025AEF2CD8.quest_desc: [
		"&7&oSome buildings are only for the dead. They remain quiet only if you are.&r"
		"&6Field note:&r Graveyards and mausoleums appear in snowy lands and are guarded."
	]
	quest.6B22D9025AEF2CD8.title: "Where the Dead Sleep"
	quest.708CF88EDA671658.quest_desc: ["&7&oOpposites, kept apart.&r"]
	quest.708CF88EDA671658.title: "Fire and Tide"
	quest.79DDACA7BB675749.quest_desc: ["&7&oMarble and silence, and something that does not stay buried.&r"]
	quest.79DDACA7BB675749.title: "A House Among the Snow"
	quest.7FEE09EF200986AB.quest_desc: [
		"&7&oIn the deepest dark of the world, something waits for an offering.&r"
		"&6Field note:&r Look in the deep dark. The shrine's block rejects you unless you hold a catalyst."
	]
	quest.7FEE09EF200986AB.title: "A Shrine That Turns Away Empty Hands"
