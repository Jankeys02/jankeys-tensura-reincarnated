	chapter.467A5D611C6C6D5B.title: "Elite Forge"
	quest.0017844C3945CF6E.quest_desc: ["&7&oArmour for someone who sings at the wrong moment.&r"]
	quest.0017844C3945CF6E.title: "The Nightingale Set"
	quest.035A32A0822B279C.quest_desc: ["&7&oBattle is a language.&r"]
	quest.035A32A0822B279C.title: "Demi God Saiyan"
	quest.0ABF1E9AD3453555.quest_desc: [
		"&7&oThe Create mod would approve.&r"
		"&6Field note:&r These two Intrinsic skills need the Create mod, which is in this pack."
	]
	quest.0ABF1E9AD3453555.title: "Machinery in the Body"
	quest.0F0B4B121C960B61.quest_desc: [
		"&7&oCreation has a patron, and he is fussy about the details.&r"
		"&6Field note:&r The forge answers its lord. Repair and reforge what exists, engrave it, conjure arms from nothing, sense the ore beneath stone, and turn a smith's mastery into a weapon."
	]
	quest.0F0B4B121C960B61.title: "Hephaestus, Lord of Creation"
	quest.2C28551B3FDAE6E1.quest_desc: ["&7&oInvitations, from a feast no one asked for.&r"]
	quest.2C28551B3FDAE6E1.title: "The Walpurgis Relics"
	quest.2DB557FC3444B05C.quest_desc: ["&7&oRank is only a way of keeping score.&r"]
	quest.2DB557FC3444B05C.title: "Medium Class Saiyan"
	quest.2EA652562751F419.quest_desc: ["&7&oAt the top, the numbers stop meaning anything.&r"]
	quest.2EA652562751F419.title: "Transcendent Saiyan"
	quest.3048A532F1975813.quest_desc: [
		"&7&oThe ground has opinions about who owns it.&r"
		"&6Field note:&r The land itself answers. Raise the earth to impale and to bind, reshape the ground your people hold, coax ore from bare stone, and draw the world's own magicule into yourself. Strongest where your nation's banner flies."
	]
	quest.3048A532F1975813.title: "Gaia, Lord of Earth"
	quest.368B3F7CC657391A.quest_desc: ["&7&oBattle is a language.&r"]
	quest.368B3F7CC657391A.title: "Intermediate Deity Saiyan"
	quest.39F248E0A0220896.quest_desc: ["&7&oA banquet hall, for the ones who are invited and the ones who are not.&r"]
	quest.39F248E0A0220896.title: "The Walpurgis Hall"
	quest.3ABE1626F9C0E690.quest_desc: [
		"&7&oMarks have grammar. Learn it.&r"
		"&6Field note:&r Hard-won intuition at the forge. Passively widens the hammer sweet spot and slows temperature drift during forge minigames. When mastered, each forged item has a chance to gain an extra enhancement slot. Learned automatically..."
	]
	quest.3ABE1626F9C0E690.title: "Runesmith's Insight"
	quest.3B32B823243C8A67.quest_desc: ["&7&oThree ages of the same sentence.&r"]
	quest.3B32B823243C8A67.title: "Runic Swords"
	quest.3C0306238D9540B2.quest_desc: [
		"&7&oThe World keeps a codex. It has not decided what to put in it.&r"
		"&6Field note:&r This chapter collects the Elite Tensura addon: its skills, the Saiyan line, its armoury and a plushie collection. Most skills here have no fixed source, so quests complete when you simply hold the skill."
	]
	quest.3C0306238D9540B2.title: "The Elite World"
	quest.3C5418627EE57E67.quest_desc: [
		"&7&oWisdom, with a name and a very low tolerance for guesses.&r"
		"&6Field note:&r The Voice of the World given form — a battlefield-computation entity. Analysis unlocks everything: prediction, barriers, reverse-engineering, and Raphael's own counsel."
	]
	quest.3C5418627EE57E67.title: "Raphael, Lord of Wisdom"
	quest.43398A64260CD205.quest_desc: ["&7&oRank is only a way of keeping score.&r"]
	quest.43398A64260CD205.title: "Divine Saiyan"
	quest.4496F4FDDDC6028E.quest_desc: ["&7&oBattle is a language.&r"]
	quest.4496F4FDDDC6028E.title: "High Class Saiyan"
	quest.44A40AA0BB7A6B50.quest_desc: [
		"&7&oA serpent finishing a sentence it started a long time ago.&r"
		"&6Field note:&r The serpent that devours its own tail. Feed on the fight, strike across seconds, shed what wounds you, rewind your missteps, complete death rather than avoid it, and devour what stands before you."
	]
	quest.44A40AA0BB7A6B50.title: "Ouroboros, Lord of Eternity"
	quest.48E66704EA9C2557.quest_desc: [
		"&7&oA keen eye for what other people left lying around.&r"
		"&6Field note:&r A keen eye for treasure. Passively grants Luck II, improving loot from chests, mob drops, and mining. Mastery unlocks a toggle that upgrades the buff to Luck III."
	]
	quest.48E66704EA9C2557.title: "Scavenger"
	quest.594B788EED9CEC14.quest_desc: [
		"&7&oWeight, redirected.&r"
		"&6Field note:&r Gravity magic. Hold to warp space at the point you are aiming at, then release to collapse it into a crushing sphere that drags everything inside toward its centre, deals a fraction of each victim's max health every second,..."
	]
	quest.594B788EED9CEC14.title: "Gravity Well"
	quest.5BD661A832F5AC47.quest_desc: ["&7&oA fighter, born to fight.&r"]
	quest.5BD661A832F5AC47.title: "Lesser Saiyan"
	quest.5CADB8E5218D4208.quest_desc: ["&7&oOne for the void, one for the stars, neither for you to lend.&r"]
	quest.5CADB8E5218D4208.title: "Edges Beyond Steel"
	quest.60EE515BD59E7BD6.quest_desc: [
		"&7&oStillness, practised until it is a skill.&r"
		"&6Field note:&r Helps regenerate Aura, Magic, and SHP faster when toggled"
	]
	quest.60EE515BD59E7BD6.title: "Mediation"
	quest.66D0FA1A7F2E0C2D.quest_desc: ["&7&oIt has been worn by someone who did not want to be remembered.&r"]
	quest.66D0FA1A7F2E0C2D.title: "The Ancient Nordic Set"
	quest.66DD071C463DE1C4.quest_desc: [
		"&7&oYou are older than you were told.&r"
		"&6Field note:&r A primordial soul that resonates with nearby life. While toggled on, grants the holder and nearby allies Strength III, Regeneration III, and Resistance I, while Soul Sight outlines surrounding creatures by alignment — red for..."
	]
	quest.66DD071C463DE1C4.title: "Ancient Soul"
	quest.6877925F24DECAEF.quest_desc: ["&7&oRank is only a way of keeping score.&r"]
	quest.6877925F24DECAEF.title: "Lesser Deity Saiyan"
	quest.700090D36AAAF2AD.quest_desc: [
		"&7&oA will that does not bend is, eventually, a wall.&r"
		"&6Field note:&r A unique skill born from an unbreakable will to endure. The holder bends hardship into strength, refusing to be undone by the world around them."
	]
	quest.700090D36AAAF2AD.title: "Iron Resolve"
	quest.7943576188A9E79C.quest_desc: ["&7&oRank is only a way of keeping score.&r"]
	quest.7943576188A9E79C.title: "Greater Deity Saiyan"
	quest.7C648142A2213BCA.quest_desc: ["&7&oNot all treasure is dangerous.&r"]
	quest.7C648142A2213BCA.title: "A Soft Collection"
	quest.7C9B8910780A1252.quest_desc: [
		"&7&oNothing is also a kind of throne.&r"
		"&6Field note:&r An ultimate skill granting absolute dominion over existence, space, and life-force. Those who wield it become sovereign over the void itself."
	]
	quest.7C9B8910780A1252.title: "Void Sovereign"
