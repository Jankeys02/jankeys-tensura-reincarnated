	quest.848D35E761F5CD59.title: "Boss Maps"
	quest.848D35E761F5CD59.quest_desc: ["Some boss structures can be located with maps.", "", "Trade with Cartographer villagers: they sell a map for each boss structure in exchange for emeralds. You may need to level the villager up first.", "", "Open the map to see where the structure is, then tick this off."]
	quest.7689082AAA65C8E3.title: "Orc Disaster Temple"
	quest.7689082AAA65C8E3.quest_desc: ["Find the Orc Disaster Temple. A boss awaits.", "", "It generates in deserts. A Cartographer villager sells a map to it."]
	quest.7B7A453C5DB15C11.title: "Beast Kingdom of Eurazania"
	quest.7B7A453C5DB15C11.quest_desc: ["Find the Beast Kingdom of Eurazania. A boss awaits.", "", "It generates in deserts and badlands. A Cartographer villager sells a map to it."]
	quest.807EBB874FB3BA95.title: "Hinata Church"
	quest.807EBB874FB3BA95.quest_desc: ["Find the Hinata Church. A boss awaits.", "", "It generates in plains, forests, taigas and meadows. A Cartographer villager sells a map to it."]
	quest.71FEDE5A759C9875.title: "Night Rose Castle"
	quest.71FEDE5A759C9875.quest_desc: ["Find the Night Rose Castle. A boss awaits.", "", "It generates in plains, forests, taigas, meadows, savannas and windswept hills. A Cartographer villager sells a map to it."]
	quest.21E324B6AC2FD19A.title: "Rimuru's Arena"
	quest.21E324B6AC2FD19A.quest_desc: ["Find the Rimuru's Arena. A boss awaits.", "", "It generates in plains, forests, taigas, meadows, cherry groves and some jungles. A Cartographer villager sells a map to it."]
	quest.EC2F3EB90E2F451F.title: "Shizu School"
	quest.EC2F3EB90E2F451F.quest_desc: ["Find the Shizu School. A boss awaits.", "", "It generates in plains and forests. A Cartographer villager sells a map to it."]
