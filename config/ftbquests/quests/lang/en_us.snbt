	quest.3B96D7C3D489E699.quest_desc: ["&7&oSome lessons are learned on the way down.&r"]
	quest.3B96D7C3D489E699.title: "No One Jumps for the Beef"
	quest.45A4873411B2D8F7.quest_desc: ["&7&oA long thing that flies. Not gracefully.&r"]
	quest.45A4873411B2D8F7.title: "Wingin' It"
	quest.4A81FE8675FB3460.quest_desc: ["&7&oIt was asleep, and now it is not.&r"]
	quest.4A81FE8675FB3460.title: "Rude Awakening"
	quest.4CA238CB03B44F5F.quest_desc: ["&7&oNot every door needs a key if you wear the right face.&r"]
	quest.4CA238CB03B44F5F.title: "Sneaking In"
	quest.4EDABBFBC768DD3F.quest_desc: [
		"&7&oSome of them are worth more whole.&r"
		"&6Field note:&r Kill a grottol with a silk touch pickaxe."
	]
	quest.4EDABBFBC768DD3F.title: "You're Coming With Me"
	quest.529F7EA940F383EA.quest_desc: ["&7&oThe brave fight it. The clever take something it will not miss.&r"]
	quest.529F7EA940F383EA.title: "Big Brain Time"
	quest.58960CF1713C9A15.quest_desc: [
		"&7&oGreen things have opinions. This one has teeth.&r"
		"&6Field note:&r Vine-things like this guard dense jungle. Keep your distance until it lunges."
	]
	quest.58960CF1713C9A15.title: "A Plant with a Temper"
	quest.5C1924ABFEE3A6B4.quest_desc: ["&7&oHeavy, honest, and made for one job.&r"]
	quest.5C1924ABFEE3A6B4.title: "What It Left Behind"
	quest.644F3D9E9F5E3346.quest_desc: [
		"&7&oA grove of masks, and a place for you if you wear one.&r"
		"&6Field note:&r Disguise yourself to walk among them."
	]
	quest.644F3D9E9F5E3346.title: "Birds of a Feather"
	quest.6AEE6D02B469DC05.quest_desc: ["&7&oSomething small and loud and not as brave as it looks.&r"]
	quest.6AEE6D02B469DC05.title: "Called Your Bluff"
	quest.6C45C4F4711D65EF.quest_desc: ["&7&oA maker of things offers a test. The test is a jump. The jump is not metaphorical.&r"]
	quest.6C45C4F4711D65EF.title: "You Must Believe"
	quest.728EB962F9AB8994.quest_desc: ["&7&oSome dens should stay warm. This one will not.&r"]
	quest.728EB962F9AB8994.title: "Where the Cold Sleeps"
	quest.755AAE3B98903BBA.quest_desc: ["&7&oThe sun, having judged, chooses to look at you.&r"]
	quest.755AAE3B98903BBA.title: "Heliomancer"
