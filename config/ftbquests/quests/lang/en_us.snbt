	task.4065B0B358FC78DC.title: "Wield fiery gear in fiery armour"
	task.415F107023BB5EA1.title: "End the many-headed thing"
	task.435C7B1356253A27.title: "Craft the magic map"
	task.4ADBBE88930F47B0.title: "End a very small noise"
