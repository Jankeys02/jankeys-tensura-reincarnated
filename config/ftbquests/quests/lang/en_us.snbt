	quest.7CDABC8B37CAC9D8.title: "Dragon Growth Hormone"
	quest.7CF02E185A1CECD1.quest_desc: ["We told you not to."]
	quest.7CF02E185A1CECD1.title: "Please Do Not Touch the Cactus"
	quest.7D45FEE42A69ABE7.quest_desc: ["Visit a warped forest."]
	quest.7D45FEE42A69ABE7.title: "Warped Forest"
	quest.7E6D1D75859BAD9A.quest_desc: ["Charybdis. A Special S-class calamity.", "", "Look for a Charybdis cave. They come in desert, ice, mesa and plains variants."]
	quest.7E6D1D75859BAD9A.title: "Storm Dragon's Spawn"
	quest.7E7B019B2258D819.quest_desc: ["Travel &e10 km&r by boat."]
	quest.7E7B019B2258D819.title: "Captain"
	quest.7F361DDC77164F76.quest_desc: [
		"{\"text\": \"\", \"extra\": [\"Craft a backpack and open it with \", {\"keybind\": \"key.backpacked.open_backpack\", \"color\": \"yellow\"}, \".\"]}"
		"More slots are unlocked with &eunlock tokens&r."
	]
	quest.7F361DDC77164F76.quest_subtitle: "Carry more"
	quest.7F361DDC77164F76.title: "Pack Mule"
	quest.7FEBFD4381D093C2.quest_desc: ["Kill a death worm. Pro tip: they love to eat TNT."]
	quest.7FEBFD4381D093C2.title: "The Desert Swimmers"
	task.0BFAC9B85EFEF9C8.title: "Unknown type: tensura_ftb:existence"
	task.1F37DDAA7A5C4F28.title: "Unknown type: tensura_ftb:existence"
	task.235568EB0C91DB3B.title: "Unknown type: tensura_ftb:existence"
	task.45FD197BAC107A9B.title: "Unknown type: tensura_ftb:existence"
	task.5CE7E939EC24D377.title: "Unknown type: tensura_ftb:existence"
	task.6070E15D5C26926B.title: "Unknown type: tensura_ftb:existence"
	task.6CB150EE18D3C321.title: "Unknown type: tensura_ftb:existence"
	task.7DAB649DCFF84DE9.title: "Unknown type: tensura_ftb:existence"
	quest.5F3AD43FE0627FCB.title: "Boss Maps"
	quest.5F3AD43FE0627FCB.quest_desc: ["Some boss structures can be located with maps.", "", "Trade with Cartographer villagers: they sell a map for each boss structure in exchange for emeralds. You may need to level the villager up first.", "", "Open the map to see where the structure is, then tick this off."]
	quest.7689082AAA65C8E3.title: "Orc Disaster Temple"
	quest.7689082AAA65C8E3.quest_desc: ["Find the Orc Disaster Temple. A boss awaits.", "", "It generates in deserts. A Cartographer villager sells a map to it."]
	quest.7B7A453C5DB15C11.title: "Beast Kingdom of Eurazania"
	quest.7B7A453C5DB15C11.quest_desc: ["Find the Beast Kingdom of Eurazania. A boss awaits.", "", "It generates in deserts and badlands. A Cartographer villager sells a map to it."]
	quest.2DFA680F102ADC7B.title: "Hinata Church"
	quest.2DFA680F102ADC7B.quest_desc: ["Find the Hinata Church. A boss awaits.", "", "It generates in plains, forests, taigas and meadows. A Cartographer villager sells a map to it."]
	quest.71FEDE5A759C9875.title: "Night Rose Castle"
	quest.71FEDE5A759C9875.quest_desc: ["Find the Night Rose Castle. A boss awaits.", "", "It generates in plains, forests, taigas, meadows, savannas and windswept hills. A Cartographer villager sells a map to it."]
	quest.21E324B6AC2FD19A.title: "Rimuru's Arena"
	quest.21E324B6AC2FD19A.quest_desc: ["Find the Rimuru's Arena. A boss awaits.", "", "It generates in plains, forests, taigas, meadows, cherry groves and some jungles. A Cartographer villager sells a map to it."]
	quest.75CE0F12D1F2F41F.title: "Shizu School"
	quest.75CE0F12D1F2F41F.quest_desc: ["Find the Shizu School. A boss awaits.", "", "It generates in plains and forests. A Cartographer villager sells a map to it."]
	chapter.000BB22D6BFA0C1D.title: "Miner's Path"
	quest.13FBE72DEA6DA594.quest_desc: [
		"Craft an iron pickaxe."
		"&6Reward:&r Ultimine up to &e12&r blocks per use, cooldown &e1.5 s&r."
	]
	quest.13FBE72DEA6DA594.title: "Apprentice Miner"
	quest.1B64083939BEE81D.quest_desc: [
		"Mine a diamond."
		"&6Reward:&r Ultimine up to &e20&r blocks per use, cooldown &e1.25 s&r."
	]
	quest.1B64083939BEE81D.title: "Journeyman Miner"
	quest.28F307535BA7E962.quest_desc: [
		"Enter the Nether."
		"&6Reward:&r Ultimine up to &e32&r blocks per use, cooldown &e1 s&r."
	]
	quest.28F307535BA7E962.title: "Adept Miner"
	quest.606087AD55A214CD.quest_desc: [
		"Summon the Wither."
		"&6Reward:&r Ultimine up to &e48&r blocks per use, cooldown &e0.75 s&r."
	]
	quest.606087AD55A214CD.title: "Expert Miner"
	quest.1B7D553666C4B095.quest_desc: [
		"Defeat the Ender Dragon."
		"&6Reward:&r Ultimine up to &e64&r blocks per use, cooldown &e0.5 s&r."
	]
	quest.1B7D553666C4B095.title: "Master Miner"
	chapter.3DD684A7ABA239F7.title: "Twilight Forest"
	quest.00C5AE37F784BB24.quest_desc: [
		"&7&oA tower rises from the canopy, and it is not empty.&r"
		"&6Field note:&r The tower is guarded. Bring gear for the dark and plenty of healing."
	]
	quest.00C5AE37F784BB24.title: "A Tower Among the Trees"
	quest.01C114E38CB50A87.quest_desc: [
		"&7&oFour staffs, four kinds of will. They want to be held together.&r"
		"&6Field note:&r Gather all four scepters of power."
	]
	quest.01C114E38CB50A87.title: "Four Voices"
	quest.02AC4666EC7F57E2.quest_desc: [
		"&7&oThe maze keeps one more secret: a vault, and a map that draws its walls.&r"
		"&6Field note:&r Open the labyrinth's hidden vault for a pickaxe that eats through stone, and craft a maze map from the focus."
	]
	quest.02AC4666EC7F57E2.title: "The Way Out"
	quest.06B2E538A0867FBB.quest_desc: [
		"&7&oThe woods are watching. Learn what lives here before it learns you.&r"
		"&6Field note:&r Hunt some of the local wildlife. Deer and boar are the easy ones."
	]
	quest.06B2E538A0867FBB.title: "What the Wild Offers"
	quest.095A8DB156BBC1A5.quest_desc: [
		"&7&oSome lessons are best taught with a club.&r"
		"&6Field note:&r Find and defeat a troll."
	]
	quest.095A8DB156BBC1A5.title: "Some Lessons Need a Club"
	quest.201949BD9423B063.quest_desc: [
		"&7&oSome doors do not look like doors. Water, held still. Green things gathered round it. Something bright, offered.&r"
		"&6Field note:&r Dig a small pool in a clearing, ring it with natural plants, and toss a diamond in."
	]
	quest.201949BD9423B063.title: "Water Held Still"
	quest.214312143915EFE2.quest_desc: [
		"&7&oSomething lives here that has too many ideas about how to kill you.&r"
		"&6Field note:&r Find the lair. Fire and a way to fight on the move help."
	]
	quest.214312143915EFE2.title: "A Lair of Many Mouths"
	quest.2275D33CCDAA3746.quest_desc: [
		"&7&oHedges no gardener planted. Walk the green walls and keep your feet quick.&r"
		"&6Field note:&r Hedge mazes hide spiders. Defeat one inside the maze."
	]
	quest.2275D33CCDAA3746.title: "Walls of Green"
	quest.22D78FE5EC5C665B.quest_desc: ["&7&oHorns, hunger, and a hot meal. Be ready for all three.&r"]
	quest.22D78FE5EC5C665B.title: "Horns and Hunger"
	quest.22D996715788846B.quest_desc: [
		"&7&oEven monsters make good meals, if you are hungry enough.&r"
		"&6Field note:&r Eat a cooked chop from the beast when your hunger bar is low."
	]
	quest.22D996715788846B.title: "Even Monsters Make Meals"
	quest.23AE4B01B0070C08.quest_desc: [
		"&7&oThe forest ends in white.&r"
		"&6Field note:&r Find the glacier. It is cold enough to hurt, and arctic armour helps."
	]
	quest.23AE4B01B0070C08.title: "The Forest Ends in White"
	quest.269D01C95FE52F8C.quest_desc: [
		"&7&oGear that burns without a fire.&r"
		"&6Field note:&r Carry a fiery tool or weapon together with at least one piece of fiery armour."
	]
	quest.269D01C95FE52F8C.title: "Gear That Burns Without a Fire"
	quest.273C58821ECAB9FF.quest_desc: ["&7&oWhat it weeps does not burn those who deserve it.&r"]
	quest.273C58821ECAB9FF.title: "Tears of Fire"
	quest.30D345BE8C1E639D.quest_desc: [
		"&7&oUnder the highlands, something large keeps house.&r"
		"&6Field note:&r Find a troll cave in the mountains."
	]
	quest.30D345BE8C1E639D.title: "Beneath the Highland Roots"
	quest.393C26C1D9E65E9B.quest_desc: [
		"&7&oA map that knows the forest, even where you have never walked.&r"
		"&6Field note:&r Craft the magic map."
	]
	quest.393C26C1D9E65E9B.title: "A Map That Knows"
	quest.4252D9BA36BA38B1.quest_desc: [
		"&7&oScales shed in the fight are good for more than trophies.&r"
		"&6Field note:&r Craft armour from the scales: a chestplate and leggings."
	]
	quest.4252D9BA36BA38B1.title: "What the Fight Left Behind"
	quest.42B812A5FB83AE21.quest_desc: [
		"&7&oThorns grow where nothing should. Something in the caves burns them away.&r"
		"&6Field note:&r Find the prize in the troll caves that burns thorn barriers."
	]
	quest.42B812A5FB83AE21.title: "Where Thorns Grow"
	quest.4571D776B0DC3561.quest_desc: [
		"&7&oWarm things can be pretty too.&r"
		"&6Field note:&r Dye a piece of arctic armour."
	]
	quest.4571D776B0DC3561.title: "Warm Things Can Be Pretty"
	quest.4E26F89AF3C931C5.quest_desc: [
		"&7&oBeyond here, the roads are unfinished. The world is still being written.&r"
		"&6Field note:&r This version of the forest ends here. More will come."
	]
	quest.4E26F89AF3C931C5.title: "Where the Road Ends"
	quest.5352308759E2F82A.quest_desc: ["&7&oOld foes, called back all at once.&r"]
	quest.5352308759E2F82A.title: "Old Foes, Called Back"
	quest.5467E1E5C41D2434.quest_desc: ["&7&oFur softer than any wool, and the beast that wears it.&r"]
	quest.5467E1E5C41D2434.title: "Softer Than Wool"
	quest.55A305CB881C7ABA.quest_desc: [
		"&7&oUnder a green hill, a maze made by something that did not want to be found.&r"
		"&6Field note:&r Find the labyrinth, a stone ruin sunk into the ground, and bring light."
	]
	quest.55A305CB881C7ABA.title: "The Maze Beneath"
	quest.5725F72D218AEA0A.quest_desc: ["&7&oA very small noise, abruptly ended.&r"]
	quest.5725F72D218AEA0A.title: "Shut"
	quest.576CFFED8D67BF4F.quest_desc: [
		"&7&oA tower of pale wood and glowing red stone. It hums when you are near.&r"
		"&6Field note:&r Find a tower growing from the forest floor."
	]
	quest.576CFFED8D67BF4F.title: "A Tower That Hums"
	quest.5C9D46EAD8245C4F.quest_desc: ["&7&oIt is long. It is patient. It has not eaten in a very long time.&r"]
	quest.5C9D46EAD8245C4F.title: "Long and Patient"
	quest.5DA67B51C8F55D44.quest_desc: ["&7&oSome things should not be taken apart. You tried anyway.&r"]
	quest.5DA67B51C8F55D44.title: "A Step Too Far"
	quest.6047E120B7F6F7BA.quest_desc: [
		"&7&oWhere the paving breaks, something old has made a home.&r"
		"&6Field note:&r Look for a ruined, paved courtyard in the forest. Bring a bow and room to run."
	]
	quest.6047E120B7F6F7BA.title: "Where the Stones Lie Broken"
	quest.66907162084B6BA1.quest_desc: ["&7&oQuiet them, and the cold towers will finally listen.&r"]
	quest.66907162084B6BA1.title: "Quiet the Dead"
	quest.6738D17DE2A2A72B.quest_desc: [
		"&7&oSomething weeps fire above the tower. Pull it down.&r"
		"&6Field note:&r Slay the small ones around a trap, then activate it to wrench the keeper from the sky."
	]
	quest.6738D17DE2A2A72B.title: "A Trap for the Sky"
	quest.69950D5CF42DD75B.quest_desc: ["&7&oA crown that remembers being a king, and does not intend to forget.&r"]
	quest.69950D5CF42DD75B.title: "A Crown That Remembers"
	quest.6D0C812813D804B5.quest_desc: ["&7&oA sheep with a grievance, and a very good memory.&r"]
	quest.6D0C812813D804B5.title: "Consummate Baaahs"
	quest.71413A2A01355CEF.quest_desc: [
		"&7&oThree mounds, three sizes of dark. Each keeps something that does not like being found.&r"
		"&6Field note:&r Clear a guardian from a small, a medium and a large hollow hill. Bigger hills hold more and hit harder."
	]
	quest.71413A2A01355CEF.title: "Three Sizes of Dark"
	quest.73CE13D5C1482D9A.quest_desc: ["&7&oA queen of ice, at the top of the world, who does not like visitors.&r"]
	quest.73CE13D5C1482D9A.title: "A Queen at the Top of the World"
	quest.7581A6A5C4042834.quest_desc: ["&7&oA palace of light, frozen mid-gesture.&r"]
	quest.7581A6A5C4042834.title: "Light, Frozen Mid-Gesture"
	quest.76B2D7CE35027A17.quest_desc: [
		"&7&oUnder a sinking hill, a company of knights waits for the dead to stop moving.&r"
		"&6Field note:&r Find the stronghold. Bring plenty of food and healing."
	]
	quest.76B2D7CE35027A17.title: "A Company of Knights"
	quest.7A28C6DBC7E4CFA2.quest_desc: [
		"&7&oAbove the clouds, something with very large hands is waiting.&r"
		"&6Field note:&r Grow a beanstalk on the glowing soil, defeat the giant above, and bring its tool back to the troll caves."
	]
	quest.7A28C6DBC7E4CFA2.title: "Above the Clouds"
	quest.7B87F88AAB34D86A.quest_desc: ["&7&oSomeone is very, very interested in trees.&r"]
	quest.7B87F88AAB34D86A.title: "Maniacal Dendrologist"
	quest.7DAD51FD1C46702C.quest_desc: ["&7&oCut one, and the others remember.&r"]
	quest.7DAD51FD1C46702C.title: "Cut One, and the Others Remember"
	quest.7F8D579F290BBBB2.quest_desc: [
		"&7&oRulers are named by what they leave on pedestals.&r"
		"&6Field note:&r Place a boss trophy on the pedestal in the ruins of the dark forest."
	]
	quest.7F8D579F290BBBB2.title: "Rulers Are Named by Their Trophies"
	task.01155A02A981A9B0.title: "Step through the door"
	task.015901270B12C145.title: "Pull the keeper down with a trap"
	task.02CFF416BCDFD614.title: "Defeat the ruler of the palace"
