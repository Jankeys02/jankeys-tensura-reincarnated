	chapter.4A77ECD140B0DA92.title: "Blood and Avalon"
	quest.00D4845D7D822431.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r A heart once claimed cannot escape desire. The true king hoards his own fate, and greed denies even death its payment."
	]
	quest.00D4845D7D822431.title: "True Authority of Greed"
	quest.0638C24919B46782.quest_desc: [
		"&7&oWhen the line is one, the line speaks as one.&r"
		"&6Field note:&r A forbidden final Bloodfiend intrinsic reserved for the Crimson Progenitor."
	]
	quest.0638C24919B46782.title: "Black Communion"
	quest.08169DB60A320D1C.quest_desc: ["&7&oSome rites need a surface.&r"]
	quest.08169DB60A320D1C.title: "An Altar for Offerings"
	quest.08D87EF521352064.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Builds Calculation Stacks in combat to optimize damage and cooldown cycles."
	]
	quest.08D87EF521352064.title: "Schwi, Lord of True Computation"
	quest.0B7993D882FFD782.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Life abides no reason— For none are born by their own consent."
	]
	quest.0B7993D882FFD782.title: "Naberius"
	quest.0C228534BD0DAD58.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Copies genes into syringes, stores extracted skills and stats, and injects mobs with artificial combat data."
	]
	quest.0C228534BD0DAD58.title: "Gene Editor"
	quest.0F199245DBD8836A.quest_desc: ["&7&oThe legend, finished.&r"]
	quest.0F199245DBD8836A.title: "True Excalibur"
	quest.0F42A7F12B24983A.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r A unique skill that evolves through punishment."
	]
	quest.0F42A7F12B24983A.title: "Adaptability"
	quest.1378014194B9A8BC.quest_desc: [
		"&7&oSome lineages are inherited. Others are chosen, and then inherited anyway.&r"
		"&6Field note:&r This chapter follows the Bloodfiend line and the relics of Avalon. Entries that appear only after you find them are unexplained gifts from the World."
	]
	quest.1378014194B9A8BC.title: "Blood and Avalon"
	quest.16DE10A7421CB39F.quest_desc: ["&7&oThe legend, made to order.&r"]
	quest.16DE10A7421CB39F.title: "Excalibur"
	quest.175B20AA3EACA2B4.quest_desc: ["&7&oA key, remembered into being something else.&r"]
	quest.175B20AA3EACA2B4.title: "The Awakened Key"
	quest.1A769614B20A1FD2.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r The god of conquest, guilt and ruin. Wields an ashen halberd and twists the world into a blood-red realm."
	]
	quest.1A769614B20A1FD2.title: "Caedros, God of Conquest"
	quest.1BEF7C0A4DF9D679.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r The origin of kingship. All treasures bow, all weapons remember. Before gods ruled, the First King reigned."
	]
	quest.1BEF7C0A4DF9D679.title: "First King of History"
	quest.21878F6E5F81BA29.quest_desc: ["&7&oThere is a version no one has been allowed to see.&r"]
	quest.21878F6E5F81BA29.title: "Divine Excalibur"
	quest.2A4320CF94ABCE30.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r An ultimate angelic key that devours prisons and suppressors, crowning space itself with divine locks."
	]
	quest.2A4320CF94ABCE30.title: "Michael, Angel of Locks"
	quest.2EEC6ED892A57763.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Re: Taekwondo perfected. Fight unarmed to inflict brain damage, recoilless knockback, projectile denial, and heaven-rending shockwaves."
	]
	quest.2EEC6ED892A57763.title: "Mori, Equal to the Heavens"
	quest.2F249B1B9A851CFA.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Earn Greed Chips on kills and gamble them for forbidden loot, power, and an extremely tiny chance at a new Ultimate Skill."
	]
	quest.2F249B1B9A851CFA.title: "Mammon: Sovereign Casino"
	quest.3910A0408ED3274D.quest_desc: [
		"&7&oTaste is a kind of rank.&r"
		"&6Field note:&r A highborn Bloodfiend capable of ruling lesser kindred. Blood Nobles possess a larger blood reserve, stronger regeneration, sharper Blood Arts, and a greater talent for binding weakened mobs into blood thralls."
	]
	quest.3910A0408ED3274D.title: "Blood Noble"
	quest.39D087B3C6BED920.quest_desc: ["&7&oRoads that go somewhere other than where they say.&r"]
	quest.39D087B3C6BED920.title: "The Paths"
	quest.3C0FF0226145C283.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r The pinnacle of sorcery and control over the undead. With this god class ultimate you shall dominate the souls"
	]
	quest.3C0FF0226145C283.title: "Sovereign of the Great Tomb"
	quest.3C4EFD65F1264241.quest_desc: [
		"&7&oA thirst with a bloodline attached.&r"
		"&6Field note:&r A cursed bloodline race that survives by stealing blood from living prey. Bloodfiends store Blood as a special resource, using it to regenerate, empower attacks, guard their body, brand victims, and create lesser kindred. Rain..."
	]
	quest.3C4EFD65F1264241.title: "Bloodfiend"
	quest.426237BB0C977B69.quest_desc: [
		"&7&oA throne made of everything it has drained.&r"
		"&6Field note:&r A sovereign monster of cursed blood. Blood Monarchs bend stolen Blood into overwhelming power, turning blood reserves into brutal damage amplification, durable crimson guards, and superior recovery."
	]
	quest.426237BB0C977B69.title: "Blood Monarch"
	quest.441048ADC49647A5.quest_desc: [
		"&7&oAge stabilises what hunger began.&r"
		"&6Field note:&r A matured Bloodfiend whose cursed blood has stabilized into a stronger spiritual body. Elder Bloodfiends hold more Blood, suffer less from water, and wield refined Blood Arts with greater control."
	]
	quest.441048ADC49647A5.title: "Elder Bloodfiend"
	quest.4515EE99DE316235.quest_desc: [
		"&7&oWhere the line began, and where it ends.&r"
		"&6Field note:&r The origin point of a Bloodfiend lineage. A Crimson Progenitor carries the purest cursed blood, commanding immense blood capacity, terrifying Blood Arts, and the least vulnerability to water among its bloodline."
	]
	quest.4515EE99DE316235.title: "Crimson Progenitor"
	quest.48F53A167ECCB93D.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r A King-Class Ultimate that adapts to everything it survives."
	]
	quest.48F53A167ECCB93D.title: "Divine General Mahoraga"
	quest.4D51B3BD8C8AC920.quest_desc: ["&7&oIt is a very honest blade.&r"]
	quest.4D51B3BD8C8AC920.title: "A Blade for Extermination"
	quest.523C4CD791EA1928.quest_desc: ["&7&oWhatever was shut can, in principle, be shut again.&r"]
	quest.523C4CD791EA1928.title: "A Key for Sealing"
	quest.525045A4048F8286.quest_desc: ["&7&oSome voices come with a halo.&r"]
	quest.525045A4048F8286.title: "A Call Answered"
	quest.5718AC35A9785348.quest_desc: ["&7&oA kingdom held in reserve.&r"]
	quest.5718AC35A9785348.title: "The Kingdom of Avalon"
	quest.593D69AF4D0AE4F1.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Space abides no reason— For the ████ disregards all boundaries. And yields to no law but its own."
	]
	quest.593D69AF4D0AE4F1.title: "Asmoday"
	quest.5A0D3DC9723CB32D.quest_desc: ["&7&oBiology, convinced it can do better.&r"]
	quest.5A0D3DC9723CB32D.title: "A Needle with Ideas"
	quest.5A9CEAD384B4A494.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Opens the Gate and births a living infection. Place the Heart once, spread Sculk across the world, empower it by feeding ores, and appoint controllers to expand the Netherveil."
	]
	quest.5A9CEAD384B4A494.title: "Netherveil Overmind"
	quest.5C72A5D779F5D164.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r A negation sphere that seals hostile abilities."
	]
	quest.5C72A5D779F5D164.title: "Domain of Negation"
	quest.606A430048DADA8D.quest_desc: [
		"&7&oA craft learned the way it is taught: by doing it to someone.&r"
		"&6Field note:&r An intrinsic Bloodfiend art that manipulates stolen Blood. Drain blood from enemies, awaken Blood Surge to amplify damage, guard yourself with Crimson Guard, brand prey, or perform the Kindred Rite on weakened mobs."
	]
	quest.606A430048DADA8D.title: "The Arts of Blood"
	quest.606ACCAA6F80FA38.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Records slain beings into your shadows. Browse the catalog, summon a parade, fuse curses into a single apex, or unleash a domain that floods the area with shadow clones."
	]
	quest.606ACCAA6F80FA38.title: "Cursed Menagerie"
	quest.60F465B2E031A59E.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r The perfected evolution of Reflector."
	]
	quest.60F465B2E031A59E.title: "Axiom, Lord of Reflected Judgment"
	quest.657B9F5942437048.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Death abides no reason— For it cannot be defied. Even by those who see it coming."
	]
	quest.657B9F5942437048.title: "Ronova"
	quest.6A78F9EF27A7B184.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r I always come back."
	]
	quest.6A78F9EF27A7B184.title: "Witch of Vainglory"
	quest.6B23CCAB970ED9F6.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r A King-Class fusion Ultimate born from Satanael and Susanoo. A reactor of wrath, a counter of dread, a stampede of ruin, and a fate that steals life itself."
	]
	quest.6B23CCAB970ED9F6.title: "Samael, Sovereign of Wrathful Fate"
	quest.6D1CEEBFD870C669.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Time abides no reason— For it deprives us all equally. Yet brooks not a second to be reclaimed."
	]
	quest.6D1CEEBFD870C669.title: "Istaroth"
	quest.6D66FACEBB3C7A76.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r An endless sovereign that devours strength. Doubles EP gain, steals MP, weakens nearby foes, and enforces Infinite Imprisonment."
	]
	quest.6D66FACEBB3C7A76.title: "Kronairos, Lord of the Endless"
	quest.735726DE753FE7BE.quest_desc: ["&7&oA room built to contain a rumour.&r"]
	quest.735726DE753FE7BE.title: "A Realm of Asmoday"
	quest.79499BE6B184EAFC.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r Within the endless wheel of Saṃsāra, each fallen life becomes a karmic echo, waiting to awaken under Nirvana’s violet grace."
	]
	quest.79499BE6B184EAFC.title: "Nirvana"
	quest.7A9A2F335B581C31.quest_desc: [
		"&7&oA name that was not meant to be written down.&r"
		"&6Field note:&r A heart once claimed cannot escape desire. The king hoards his own fate, and greed denies even death its payment."
	]
	quest.7A9A2F335B581C31.title: "Authority of Greed"
