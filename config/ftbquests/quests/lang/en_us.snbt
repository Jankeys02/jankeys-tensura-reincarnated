	quest.04A0740FFDED2ED7.quest_desc: ["&7&oA place built for quiet. It no longer is.&r"]
	quest.04A0740FFDED2ED7.title: "Stone and Silence"
	quest.056A74451D5D9BEA.quest_desc: [
		"&7&oSome creatures pay out in what you mine them with.&r"
		"&6Field note:&r Kill a grottol with a fortune pickaxe."
	]
	quest.056A74451D5D9BEA.title: "Double or Nothing"
	quest.0F0EC1DA5D1496A1.quest_desc: ["&7&oSomething howls at the moon, and the moon answers.&r"]
	quest.0F0EC1DA5D1496A1.title: "Gibbous Gibbons"
	quest.1195A584091E4A40.quest_desc: ["&7&oA mask that glows when you do not.&r"]
	quest.1195A584091E4A40.title: "A Face of the Sun"
	quest.233BF7263CCE37EF.quest_desc: ["&7&oIt has lost bits before. It will lose more.&r"]
	quest.233BF7263CCE37EF.title: "Just a Flesh Wound"
	quest.236847EE4CCCF40D.quest_desc: ["&7&oSmall, round, and made of rock. It does not deserve what you are about to do.&r"]
	quest.236847EE4CCCF40D.title: "A Quiet Thing in the Stone"
