	task.1EB6E42108AFAB07.title: "Learn to fly on holy wings"
	task.1F577A44BD894F15.title: "Awaken as a timeless mage"
	task.2379FF1D26513D3A.title: "Learn to draw things in"
	task.24553662D8702ED1.title: "Learn to command what you carry"
	task.251E03C3562CC132.title: "Make an aura rune"
	task.2BB8F64EFBFA591A.title: "Learn to charge"
	task.2F357BDE35C1E97B.title: "Craft a magicule enhancer"
	task.31ADCBD18F1D4D8C.title: "Obtain a suppression stone"
	task.3E32651B87D06788.title: "Learn to resonate"
	task.43B46ADD0FC7F2CB.title: "Awaken as a dragon slayer"
	task.4418B1D0443F2626.title: "Awaken as an unbound jester"
	task.47DF457DC8F1EA79.title: "Be recognised as a True Hero"
	task.4877A672D7BCD571.title: "Obtain a skill stone"
	task.4A53642C47EAA014.title: "Make an adept efficiency rune"
	task.5470E88DC09A09F1.title: "Take up a soul echo"
	task.57A8145C15BFAD25.title: "Learn to charge fully"
	task.58BA8E86E2546592.title: "Make an area rune"
	task.5A878B578EBE439F.title: "Make an enhanced efficiency rune"
	task.5D8FB5C201C3AA99.title: "Open the eye of mind"
	task.5E178547F9316816.title: "Become a great mage"
	task.61AB1E46B5BA0B7F.title: "Awaken as the one who seals"
	task.65597C8FA9D2CB91.title: "Stand in the hyperbolic chamber"
	task.6E7F66CE5B4654C2.title: "Learn to scribe magic"
	task.76CAA5ACA04E81F5.title: "Make a basic efficiency rune"
	task.788AFADFD9117023.title: "Build the awakening altar"
	chapter.5C7AF98491C81F15.title: "Lineages of Ascension"
	quest.00EC3794D0408330.quest_desc: [
		"&7&oThe old ones remember being warm.&r"
		"&6Field note:&r A bloodfiend who has come into their kin and their craft."
	]
	quest.00EC3794D0408330.title: "Kindred Bloodfiend"
	quest.0109E5C96A626095.quest_desc: [
		"&7&oEach eye has its own opinion.&r"
		"&6Field note:&r A lesser beholder of armored body and unraveling eyestalks."
	]
	quest.0109E5C96A626095.title: "Gauth"
	quest.012CBEC4F4F3CB06.quest_desc: [
		"&7&oA soul given to the sea, and the sea accepted.&r"
		"&6Field note:&r A Wight who gave their soul to the cursed sea. Deathless and waterborne."
	]
	quest.012CBEC4F4F3CB06.title: "Cursed Mariner"
	quest.01E8CB809C1F84BC.quest_desc: [
		"&7&oWar and study both keep you here.&r"
		"&6Field note:&r Bones bound by death. Faster, immune to pain/poison/pierce/paralysis. No need for food. Still burns in sunlight; splits next into Warrior or Mage."
	]
	quest.01E8CB809C1F84BC.title: "Skeleton"
	quest.0200EEC2D4CBA5F7.quest_desc: [
		"&7&oPoison is a kind of patience.&r"
		"&6Field note:&r Ruler of the wetlands, master of water and miasma."
	]
	quest.0200EEC2D4CBA5F7.title: "Swamp Sovereign"
	quest.0482B7407CA9BFA0.quest_desc: [
		"&7&oSmall, bright, and very good at being overlooked.&r"
		"&6Field note:&r A newborn djinn of small stature and great magical potential."
	]
	quest.0482B7407CA9BFA0.title: "Whisper Djinn"
	quest.055A8FFCE26B8561.quest_desc: [
		"&7&oA throne without a kingdom, or a library without a visitor. Either way, the end.&r"
		"&6Field note:&r Apex of the mage path. Spatial Domination, All-Seeing Eye, Mortal Fear and Majesty."
	]
	quest.055A8FFCE26B8561.title: "Lich King"
	quest.0742979BDC621095.quest_desc: [
		"&7&oBone remembers. Muscle does not.&r"
		"&6Field note:&r A skeleton tempered for war. Strengthen Body, Corrosion, Self Regen. No longer burns in sunlight."
	]
	quest.0742979BDC621095.title: "Skeleton Warrior"
	quest.0B5F316D9FC356D5.quest_desc: [
		"&7&oBone remembers. Muscle does not.&r"
		"&6Field note:&r A skeleton schooled in arcane sciences. Magic Resistance, Thought Acceleration, Magic Sense, all four elemental Manipulations."
	]
	quest.0B5F316D9FC356D5.title: "Mage Skeleton"
	quest.0BE373EE882203E5.quest_desc: [
		"&7&oCorruption grows into the shape it was always going to have.&r"
		"&6Field note:&r A Named Corrupted Dragon — its breath is black flame that scorches flesh and soul."
	]
	quest.0BE373EE882203E5.title: "Cursed Dragon"
	quest.0CB39D92574C9DDF.quest_desc: [
		"&7&oA first feather, and a heavy question.&r"
		"&6Field note:&r A winged being of holy light. The first step on the angelic path."
	]
	quest.0CB39D92574C9DDF.title: "Angel"
	quest.0F88E55503E8C001.quest_desc: [
		"&7&oTails are counted, until they are not.&r"
		"&6Field note:&r A Kitsune whose power has bloomed into three tails."
	]
	quest.0F88E55503E8C001.title: "3 Tailed Fox"
	quest.0FBF45898D761615.quest_desc: [
		"&7&oEvery marsh has a monarch. The marsh has yet to learn it.&r"
		"&6Field note:&r A Named Swamp Sovereign of immense age, in tune with the earth itself."
	]
	quest.0FBF45898D761615.title: "Bog Ancient"
	quest.172D13B69AA9AF13.quest_desc: [
		"&7&oThere is a kind of power that stops being measured and starts being weather.&r"
		"&6Field note:&r The pinnacle of djinn existence — authority that permeates every layer of reality."
	]
	quest.172D13B69AA9AF13.title: "Omniversal Djinn"
	quest.1908754AE23EFF06.quest_desc: [
		"&7&oThe first of them, and the last that anyone wants to meet.&r"
		"&6Field note:&r The first and most terrible of all bloodfiends — its will rewrites the laws of death."
	]
	quest.1908754AE23EFF06.title: "Progenitor Bloodfiend"
	quest.196826719E603718.quest_desc: [
		"&7&oA wish is a debt with better manners.&r"
		"&6Field note:&r A djinn crossed into divinity, commanding the laws of the world."
	]
	quest.196826719E603718.title: "Ascended Djinn"
	quest.1A684353790E121A.quest_desc: [
		"&7&oBone remembers. Muscle does not.&r"
		"&6Field note:&r The headless rider. Physical Attack Nullification and a spectral Skeleton Horse."
	]
	quest.1A684353790E121A.title: "Dullahan"
	quest.1CC8B9ED697C40E6.quest_desc: [
		"&7&oThe pond is larger than it looks.&r"
		"&6Field note:&r A toad whose body secretes lethal venom."
	]
	quest.1CC8B9ED697C40E6.title: "Poison Toad"
	quest.1F0A4526833CD7B1.quest_desc: [
		"&7&oA god of shadow, which is a kind of apology.&r"
		"&6Field note:&r Apex of draconic corruption — a god of shadow and flame."
	]
	quest.1F0A4526833CD7B1.title: "Demon Dragon God"
	quest.1FC7175F4678D53A.quest_desc: [
		"&7&oThe dark has etiquette.&r"
		"&6Field note:&r An aristocrat of blood and shadow — charming, near-impervious, master of the night."
	]
	quest.1FC7175F4678D53A.title: "Blood Noble"
	quest.210B0D85C1332563.quest_desc: [
		"&7&oEvery marsh has a monarch. The marsh has yet to learn it.&r"
		"&6Field note:&r A Swamp Sovereign awakened as a True Demon Lord — corruption made flesh."
	]
	quest.210B0D85C1332563.title: "Venom Lord"
	quest.215EE5F38F772251.quest_desc: [
		"&7&oPast divinity, or past mercy. Either way, past you.&r"
		"&6Field note:&r A Fallen Angel ascended into a force of primordial chaos."
	]
	quest.215EE5F38F772251.title: "Chaotic Deity"
	quest.23CAE247E8490C20.quest_desc: [
		"&7&oA throne without a kingdom, or a library without a visitor. Either way, the end.&r"
		"&6Field note:&r Apex of the warrior path. Mortal Fear, Majesty, and a Multilayer Barrier wreathe the throneless king."
	]
	quest.23CAE247E8490C20.title: "Dark Lord Dullahan"
	quest.24C6E1482C2DCCE5.quest_desc: [
		"&7&oA body can be a tool, if you practise.&r"
		"&6Field note:&r A master of unarmed combat, body forged into a weapon."
	]
	quest.24C6E1482C2DCCE5.title: "Monkey Martial Artist"
	quest.27A660F24595C2B3.quest_desc: [
		"&7&oBlack flame has its own weight.&r"
		"&6Field note:&r A Cursed Dragon awakened as a True Demon Lord. Wields darkness absolutely."
	]
	quest.27A660F24595C2B3.title: "Demonic Dragon"
	quest.2AF59864964C31A7.quest_desc: [
		"&7&oA wish is a debt with better manners.&r"
		"&6Field note:&r A djinn fused with element, daemon, and dragon essences. Power without ceiling."
	]
	quest.2AF59864964C31A7.title: "Infinite Djinn"
	quest.30A132487EC0944D.quest_desc: [
		"&7&oSome of them stopped counting the ages.&r"
		"&6Field note:&r A djinn who has mastered misdirection and trickery."
	]
	quest.30A132487EC0944D.title: "Trickster Djinn"
	quest.31CE7F801B4ADB34.quest_desc: [
		"&7&oSomething small, in water, with opinions.&r"
		"&6Field note:&r A small amphibian with a knack for water and poison. The first step."
	]
	quest.31CE7F801B4ADB34.title: "Frog"
	quest.35B80917B0686856.quest_desc: [
		"&7&oEach eye has its own opinion.&r"
		"&6Field note:&r A Gazer with sharper sight — pierces all falsehood."
	]
	quest.35B80917B0686856.title: "Spectator"
	quest.36F6120EFBFC7283.quest_desc: [
		"&7&oAt the end of seeing, something that looks back.&r"
		"&6Field note:&r A Spectator that fuses perception with domination."
	]
	quest.36F6120EFBFC7283.title: "Mindwitness"
	quest.37DD417DE62F7139.quest_desc: [
		"&7&oThere is a name that heaven could not hold.&r"
		"&6Field note:&r The Great Sage Equal to Heaven. Reshapes the laws of the world."
	]
	quest.37DD417DE62F7139.title: "Sun Wukong"
	quest.38AAD724AE4BAFAD.quest_desc: [
		"&7&oSalt does not rust what is already dead.&r"
		"&6Field note:&r A Cursed Mariner hardened by battle. Commands the storm and fractures into shadow."
	]
	quest.38AAD724AE4BAFAD.title: "Cursed Dreadnaught"
	quest.3C21631B0A7A22E8.quest_desc: [
		"&7&oAt the end of seeing, something that looks back.&r"
		"&6Field note:&r A Beholder who transcended death itself — sovereign of life and void."
	]
	quest.3C21631B0A7A22E8.title: "Death Tyrant"
	quest.3D04D3583550D8E2.quest_desc: [
		"&7&oA throne is a kind of trick.&r"
		"&6Field note:&r A monkey hardened through battle into raw physical strength."
	]
	quest.3D04D3583550D8E2.title: "Monkey Warrior"
	quest.3D5393D0A53996A4.quest_desc: [
		"&7&oWar and study both keep you here.&r"
		"&6Field note:&r A skeletal sage of long centuries. Sage skill at Lich-tier mastery."
	]
	quest.3D5393D0A53996A4.title: "Elder Lich"
	quest.3DA5A1053B4F47D8.quest_desc: [
		"&7&oSome of them stopped counting the ages.&r"
		"&6Field note:&r Sovereign of all djinnkind, wreathed in dread majesty."
	]
	quest.3DA5A1053B4F47D8.title: "Sovereign Djinn"
	quest.3EBDFD83FACC79AB.quest_desc: [
		"&7&oWar and study both keep you here.&r"
		"&6Field note:&r Armored death given purpose. Magic Resistance and command of Lesser Undead."
	]
	quest.3EBDFD83FACC79AB.title: "Death Knight"
	quest.41470656C4792B24.quest_desc: [
		"&7&oSpace is just another thing you can fold.&r"
		"&6Field note:&r Half dragon, half dimensional horror. Their colossal frame tears space."
	]
	quest.41470656C4792B24.title: "Abyssal Dragonewt"
	quest.420523D9C47B11FD.quest_desc: [
		"&7&oTails are counted, until they are not.&r"
		"&6Field note:&r The legendary nine-tailed fox — a true hero of fox-kind."
	]
	quest.420523D9C47B11FD.title: "9 Tailed Fox"
	quest.423244A75A861487.quest_desc: [
		"&7&oA body can be a tool, if you practise.&r"
		"&6Field note:&r A Monkey King who crossed into divinity."
	]
	quest.423244A75A861487.title: "Divine King"
	quest.44F6B5D35B3C49E8.quest_desc: [
		"&7&oThe first whisper of something that wants more.&r"
		"&6Field note:&r A Dragonewt touched by the first whisper of demonic corruption."
	]
	quest.44F6B5D35B3C49E8.title: "Corrupted Dragonkin"
	quest.454ECC621F07BB1F.quest_desc: [
		"&7&oEvery marsh has a monarch. The marsh has yet to learn it.&r"
		"&6Field note:&r The pinnacle of frogkind. Combines the wisdom of the bog with the corruption of venom."
	]
	quest.454ECC621F07BB1F.title: "Frog Monarch"
	quest.495D98A7CADE4F66.quest_desc: [
		"&7&oBone remembers. Muscle does not.&r"
		"&6Field note:&r A true necromancer. Spatial Manipulation and Magic Darkness Transform unlock."
	]
	quest.495D98A7CADE4F66.title: "Lich"
	quest.4C397734D4F15848.quest_desc: [
		"&7&oBeyond the count of tails, only the name remains.&r"
		"&6Field note:&r An Inari-tier celestial fox transcending the count of tails. Gains Mana Manipulation."
	]
	quest.4C397734D4F15848.title: "Divine Kitsune"
	quest.51EAB8BB07624BF2.quest_desc: [
		"&7&oThe deep keeps a throne. It has been empty a long time.&r"
		"&6Field note:&r Lord of the deep. A True Demon Lord whose will reshapes the ocean."
	]
	quest.51EAB8BB07624BF2.title: "Davy Jones"
	quest.536C2D3342B7FB3E.quest_desc: [
		"&7&oStorms answer to the right captain.&r"
		"&6Field note:&r A dread pirate dissolved into spectral darkness — slips through walls and commands the deep."
	]
	quest.536C2D3342B7FB3E.title: "Phantom Corsair"
	quest.55AFE0EF76826BE4.quest_desc: [
		"&7&oWhat stood up should have stayed down.&r"
		"&6Field note:&r A risen corpse — entry to the Undead chain, branching off the Wight race. Pain Resistance and Majin alignment, but burns and weakens in sunlight."
	]
	quest.55AFE0EF76826BE4.title: "Zombie"
	quest.5A72B294F4EA97D1.quest_desc: [
		"&7&oEvery step up is a step away from something.&r"
		"&6Field note:&r A Seraphim who walked the hero's path and ascended to true divinity."
	]
	quest.5A72B294F4EA97D1.title: "Divine Angel"
	quest.5A7E95C2BDD198BD.quest_desc: [
		"&7&oA wish is a debt with better manners.&r"
		"&6Field note:&r A djinn whose power rivals myth, bound only by the wishes they grant."
	]
	quest.5A7E95C2BDD198BD.title: "Wishbound Djinn"
	quest.5DAFD8BA5978290E.quest_desc: [
		"&7&oPoison is a kind of patience.&r"
		"&6Field note:&r A frog grown massive — pure physical force."
	]
	quest.5DAFD8BA5978290E.title: "Giant Frog"
	quest.5F19FE806781DEB4.quest_desc: [
		"&7&oSovereign of the void, with nothing left to rule.&r"
		"&6Field note:&r Sovereign of the void. Reality bends around their presence."
	]
	quest.5F19FE806781DEB4.title: "Chaos Dragon"
	quest.5F77B2EC580043E6.quest_desc: [
		"&7&oSome of them stopped counting the ages.&r"
		"&6Field note:&r A noble djinn blessed with divine ki."
	]
	quest.5F77B2EC580043E6.title: "Royal Djinn"
	quest.64B2BD9CF8FE4837.quest_desc: [
		"&7&oA wish is a debt with better manners.&r"
		"&6Field note:&r A djinn shed of corporeal limits — a phantom of flickering presence."
	]
	quest.64B2BD9CF8FE4837.title: "Phantom Djinn"
	quest.6539C4536725B1F3.quest_desc: [
		"&7&oThe old ones remember being warm.&r"
		"&6Field note:&r An ancient predator who moves between shadows like a wraith."
	]
	quest.6539C4536725B1F3.title: "Elder Bloodfiend"
	quest.6799DD4D27D3005F.quest_desc: [
		"&7&oPast divinity, or past mercy. Either way, past you.&r"
		"&6Field note:&r A Divine Angel ascended past divinity itself, governing the fabric of the cosmos."
	]
	quest.6799DD4D27D3005F.title: "Cosmic Deity"
	quest.68274D0DEF60787E.quest_desc: [
		"&7&oThe End leaves its mark on whatever stays long enough.&r"
		"&6Field note:&r A Dragonewt forever altered by the End — scales drink darkness, eyes burn ender flame."
	]
	quest.68274D0DEF60787E.title: "Ender Dragonewt"
	quest.6CDAB482930EDE33.quest_desc: [
		"&7&oA frame too large for a single place.&r"
		"&6Field note:&r A dragonewt flickering between presence and void. Bends space and gravity."
	]
	quest.6CDAB482930EDE33.title: "Void Dragonewt"
	quest.6CED21E75E319E18.quest_desc: [
		"&7&oSome of them stopped counting the ages.&r"
		"&6Field note:&r An original djinn from before civilization. Their presence alone breaks lesser wills."
	]
	quest.6CED21E75E319E18.title: "Primordial Djinn"
	quest.703F552DC3CA265A.quest_desc: [
		"&7&oLight has a weight.&r"
		"&6Field note:&r A Seraphim who consumed daemonic remains and fell into corruption. Alignment shifts to Majin."
	]
	quest.703F552DC3CA265A.title: "Fallen Angel"
	quest.7197EF4803AFEA3E.quest_desc: [
		"&7&oA throne is a kind of trick.&r"
		"&6Field note:&r A sovereign of beasts, claimed via Royal Blood."
	]
	quest.7197EF4803AFEA3E.title: "Monkey King"
	quest.71980EDC7C51361B.quest_desc: [
		"&7&oNewly turned, and already hungry.&r"
		"&6Field note:&r A newly turned bloodfiend, still raw and hungry."
	]
	quest.71980EDC7C51361B.title: "Fledgling Bloodfiend"
	quest.728E93FD83341E90.quest_desc: [
		"&7&oSight is a weapon with a long reach.&r"
		"&6Field note:&r Apex of the aberrant lineage. Central eye negates magic; stalks rain devastation."
	]
	quest.728E93FD83341E90.title: "Beholder"
	quest.7480E9D6F5DE0657.quest_desc: [
		"&7&oEach tail is a promise kept.&r"
		"&6Field note:&r A fox spirit of six tails, brimming with spiritual force."
	]
	quest.7480E9D6F5DE0657.title: "6 Tailed Fox"
	quest.7A432357D4871A5C.quest_desc: [
		"&7&oBlack flame has its own weight.&r"
		"&6Field note:&r Corruption blossomed into full draconic form. Shadow magic flows in its veins."
	]
	quest.7A432357D4871A5C.title: "Corrupted Dragon"
	quest.7BC978FD9DD26FA4.quest_desc: [
		"&7&oIt floats, and it watches, and it has already noticed you.&r"
		"&6Field note:&r A floating majin of countless eyes, born from the void."
	]
	quest.7BC978FD9DD26FA4.title: "Gazer"
	quest.7D251A09378B3B3E.quest_desc: [
		"&7&oQuick, clever, and always one step ahead of a lesson.&r"
		"&6Field note:&r A clever, nimble beast brimming with potential."
	]
	quest.7D251A09378B3B3E.title: "Monkey"
	quest.7F82CF82C2FAF2EC.quest_desc: [
		"&7&oA spirit, named, and curious.&r"
		"&6Field note:&r A Named beastfolk fox spirit awakened to mystical potential."
	]
	quest.7F82CF82C2FAF2EC.title: "Kitsune"
	quest.7F9428C5A9574035.quest_desc: [
		"&7&oLight has a weight.&r"
		"&6Field note:&r The peak of angelic existence. Branches into Divine Angel (true hero) or Fallen Angel (consume 10 daemon essences)."
	]
	quest.7F9428C5A9574035.title: "Seraphim"
	quest.7FDFC8356BCFF2F2.quest_desc: [
		"&7&oEvery step up is a step away from something.&r"
		"&6Field note:&r A higher angel commanding sacred aura and divine ki."
	]
	quest.7FDFC8356BCFF2F2.title: "Archangel"
