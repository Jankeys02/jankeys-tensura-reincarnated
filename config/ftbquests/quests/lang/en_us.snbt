	quest.0E1C30F879545209.quest_desc: ["&7&oSomething is off about this soup.&r"]
	quest.0E1C30F879545209.title: "When the Stew Is Sus"
	quest.1664160FE3D4C05D.quest_desc: ["&7&oA small stone with a very large idea.&r"]
	quest.1664160FE3D4C05D.title: "A Stone for the Road"
	quest.2230ED5EEBD042D4.quest_desc: ["&7&oThe most important piece of kit on any expedition.&r"]
	quest.2230ED5EEBD042D4.title: "Packed Lunch"
	quest.22BCD51822160A86.quest_desc: ["&7&oA rope is a promise: you can come back down.&r"]
	quest.22BCD51822160A86.title: "Hanging by a Thread"
	quest.23EE6FA88B3FC773.quest_desc: ["&7&oFireflies and fish and small things that glow.&r"]
	quest.23EE6FA88B3FC773.title: "Small Prisons"
	quest.2A541F2330E520A4.quest_desc: ["&7&oA promise, written down, that you will be elsewhere.&r"]
	quest.2A541F2330E520A4.title: "Scrolls and Promises"
	quest.2ACDE19717E4AD1A.quest_desc: [
		"&7&oA turn here, a turn there. Nothing is permanent.&r"
		"&6Field note:&r A wrench rotates blocks in place."
	]
	quest.2ACDE19717E4AD1A.title: "Engineer Gaming"
	quest.2EC94C3C7C0F84F5.quest_desc: ["&7&oSoft things in a sack, and valuable things in a safe.&r"]
	quest.2EC94C3C7C0F84F5.title: "Somewhere to Keep Things"
	quest.3563D1F3A2612475.quest_desc: ["&7&oSome stones are meant to be shared.&r"]
	quest.3563D1F3A2612475.title: "Shared Roads"
	quest.35FD138096BD01BE.quest_desc: [
		"&7&oWherever you fall asleep, it is a bed.&r"
		"&6Field note:&r Sleeping bags let you rest almost anywhere."
	]
	quest.35FD138096BD01BE.title: "A Bag for the Road"
	quest.3AB33F65AF187335.quest_desc: [
		"&7&oA home starts with something to hang a rest on.&r"
		"&6Field note:&r Rope and nails are the base for hammocks."
	]
	quest.3AB33F65AF187335.title: "Rope and Nail"
	quest.3C06D309A3953372.quest_desc: ["&7&oStand on it, and you are somewhere else.&r"]
	quest.3C06D309A3953372.title: "A Plate That Waits"
	quest.46DFDD79BAFC01B2.quest_desc: ["&7&oSome things are not food.&r"]
	quest.46DFDD79BAFC01B2.title: "Tide Pod Challenge"
	quest.4CA2C66066B3A9BD.quest_desc: ["&7&oA door that does not need a frame.&r"]
	quest.4CA2C66066B3A9BD.title: "A Door in a Stone"
	quest.634E61CA6C9BB8FF.quest_desc: ["&7&oA cup of something in the dark place.&r"]
	quest.634E61CA6C9BB8FF.title: "Consume the Concoction Chalice"
	quest.65BA6946818B7659.quest_desc: ["&7&oA wreck with a flag still flying.&r"]
	quest.65BA6946818B7659.title: "Ships Adrift"
	quest.69F17123AF5925A9.quest_desc: [
		"&7&oThere is no problem a hammock cannot postpone.&r"
		"&6Field note:&r Hang it with rope and nail where there is room for the sling."
	]
	quest.69F17123AF5925A9.title: "Swing Low"
	quest.6A219316C7D84A01.quest_desc: ["&7&oSometimes you are the thing that rotates.&r"]
	quest.6A219316C7D84A01.title: "How the Turn Tables"
	quest.6C8A357843B129C8.quest_desc: [
		"&7&oStand beside one, and it learns your name.&r"
		"&6Field note:&r Activate a waystone by right-clicking it, and it joins your network."
	]
	quest.6C8A357843B129C8.title: "A Stone That Remembers"
	quest.6EF0C5CB241C85A4.quest_desc: ["&7&oSomeone left directions. They look reliable.&r"]
	quest.6EF0C5CB241C85A4.title: "This Must Be a Sign!"
	quest.742FE5CFF5BCF939.quest_desc: ["&7&oThe parrot does not consent.&r"]
	quest.742FE5CFF5BCF939.title: "Angry Birds"
