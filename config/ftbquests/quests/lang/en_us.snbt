	quest.07F9E6A0C51D7EE9.quest_desc: ["&7&oSome things can only be made by following instructions someone else wrote.&r"]
	quest.07F9E6A0C51D7EE9.title: "Plans for the Impossible"
	quest.12C47866A200EF18.quest_desc: [
		"&7&oYour own kind, with a dragon folded into it.&r"
		"&6Field note:&r A dragon adjacent being reborn has a sub-True Dragon after analyzing and integrating into themselves the essence of a True Dragon."
	]
	quest.12C47866A200EF18.title: "Pure Dragon"
