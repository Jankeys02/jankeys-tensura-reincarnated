	chapter_group.0F30C975BF218986.title: "Tensura Addons"
	chapter.6370658D2DADB7B5.title: "Ascension"
	quest.02334510CD2BF427.quest_desc: [
		"&7&oThe eye that sees what the others cannot.&r"
		"&6Field note:&r Toggle: 10x learning/mastery rate. Modes: Analytical Appraisal (read the battlefield), Analysis (steal a skill from an enemy), Detrimental Gaze (inflict crippling status), Ray of Death (black beam draining a fraction of target..."
	]
	quest.02334510CD2BF427.title: "Eye of Mind"
	quest.03D8BEA3C559791D.quest_desc: [
		"&7&oSome knowledge is not read. It is chanted into being.&r"
		"&6Field note:&r Toggle: +19% learning/mastery rate for all skills, plus Chant Annulment for mastered magic. Modes: Magic Chant (learn new magic for XP), Study (steal a skill from a target's mind), Create Tome (turn a learned magic into a tome..."
	]
	quest.03D8BEA3C559791D.title: "The Great Mage"
	quest.0B3FCD34458A10BA.quest_desc: [
		"&7&oAn echo that answers back.&r"
		"&6Field note:&r Toggle: +25% magicule regen (+50% mastered). Auto-learned once Magicule Resonance is mastered."
	]
	quest.0B3FCD34458A10BA.title: "Magicule Dominion"
	quest.1A16855E62D4E015.quest_desc: ["&7&oThe World has weighed you and found a sovereign of the dark.&r"]
	quest.1A16855E62D4E015.title: "A True Demon Lord"
	quest.2CBF3024ADCEC8B9.quest_desc: ["&7&oThe World has weighed you and found a hero.&r"]
	quest.2CBF3024ADCEC8B9.title: "A True Hero"
	quest.2F622ABE5F20A036.quest_desc: ["&7&oSome rooms are only reached by being sent.&r"]
	quest.2F622ABE5F20A036.title: "The Hyperbolic Chamber"
	quest.34CAD9AB0EBEB36D.quest_desc: [
		"&7&oThings fall toward you. This is not luck.&r"
		"&6Field note:&r Active: pull nearby items and XP orbs to you within 8 blocks for 5s (12 blocks / 10s mastered). Costs 2000 magicule (1000 mastered). 20s cooldown (10s mastered). Obtained by using a plunderer skill on an Iron Golem."
	]
	quest.34CAD9AB0EBEB36D.title: "Magnetized Vacuum"
	quest.37C0EB83DE240AA3.quest_desc: [
		"&7&oThree marks, each louder than the last.&r"
		"&6Field note:&r The runes boost magicule by 50%, 100% and 200% (1.5x, 2x, 3x in total)."
	]
	quest.37C0EB83DE240AA3.title: "Runes of Efficiency"
	quest.3853A27318EA783B.quest_desc: [
		"&7&oA meal with no table.&r"
		"&6Field note:&r Press: refill hunger and grant saturation for 15% of max magicule (7.5% mastered). 10s cooldown (5s mastered)."
	]
	quest.3853A27318EA783B.title: "Magicule Nourishment"
	quest.3CE9E15935B78C31.quest_desc: [
		"&7&oFifty sweetnesses, and what they cost.&r"
		"&6Field note:&r Ultimate awakening of Bubble Majin. Toggle: full HP heal every 10s, cleanse all negative effects every 5s, reflect basic projectiles. Modes: Storage, Candy for me! (12-block AOE — turns every entity you're 2x stronger than (5x..."
	]
	quest.3CE9E15935B78C31.title: "The Evil Majin"
	quest.3D3B60D5A13FD40C.quest_desc: [
		"&7&oListening, repeated, becomes an echo.&r"
		"&6Field note:&r Toggle: +10% magicule regen (+20% mastered). Auto-learned once Magicule Attunement is mastered."
	]
	quest.3D3B60D5A13FD40C.title: "Magicule Resonance"
	quest.4663CB56DFAD1486.quest_desc: [
		"&7&oA spell you cannot write down is a spell you will lose.&r"
		"&6Field note:&r Press: inscribe a random spell scroll. Level 1 on a 5min cooldown (random level / 2min mastered)."
	]
	quest.4663CB56DFAD1486.title: "Magic Scribe"
	quest.4943F1CC92D0943A.quest_desc: [
		"&7&oPillars of crystal-veined stone, and a space in the middle.&r"
		"&6Field note:&r Only a True Demon Lord or True Hero with 5,000,000 maximum EP can awaken an Ultimate."
	]
	quest.4943F1CC92D0943A.title: "An Altar That Waits"
	quest.4F0BD898FA962B46.quest_desc: [
		"&7&oThirty offerings, one very large silence.&r"
		"&6Field note:&r Ultimate awakening of Dragon Slayer. Toggle on for: peace with all dragons; ice/fire/thunder breath bypass resistances; +30 Max HP per dragon essence or Ice&Fire flesh eaten (no cap, removed on death); each dragon kill..."
	]
	quest.4F0BD898FA962B46.title: "The Slayer of Dragons"
	quest.4FA50DC4290EC853.quest_desc: [
		"&7&oThe very strong leave echoes. Gather one.&r"
		"&6Field note:&r A soul echo drops from slain bosses or named creatures with at least 200,000 maximum EP."
	]
	quest.4FA50DC4290EC853.title: "What Remains of Giants"
	quest.502CEAA8DFCC80EB.quest_desc: [
		"&7&oPower that waits is still power.&r"
		"&6Field note:&r Hold: regen 5% max magicule/s (7% mastered) at the cost of 1% max aura/s. Auto-learned at 25,000 EP."
	]
	quest.502CEAA8DFCC80EB.title: "Energy Charge"
	quest.563786E0E1767197.quest_desc: [
		"&7&oEchoes, gathered, wish to become a single thing.&r"
		"&6Field note:&r Throw it onto an Awakening Altar and right-click. Which Ultimate you get depends on the Unique you have mastered."
	]
	quest.563786E0E1767197.title: "The Ultimate Catalyst"
	quest.60543548BEB03AB5.quest_desc: ["&7&oNot every mark is about strength. Some are about where it falls.&r"]
	quest.60543548BEB03AB5.title: "Runes of Reach"
	quest.612AF6443730BF4C.quest_desc: [
		"&7&oNot every flight needs a sky.&r"
		"&6Field note:&r Toggle: glide through the air like an elytra without wings equipped."
	]
	quest.612AF6443730BF4C.title: "Angel Wings"
	quest.6FEA7EC441CDB3A1.quest_desc: [
		"&7&oThe Great Mage, finished.&r"
		"&6Field note:&r Ultimate awakening of Great Mage. Auto-learns and masters every aspectual and spirit magic; passive chant annulment. Toggle: +29 mastery gain, perfect Analytical Appraisal, magic bypasses resistances, and grants creative..."
	]
	quest.6FEA7EC441CDB3A1.title: "Timeless Mage"
	quest.7131ED4787B854CA.quest_desc: [
		"&7&oThe air here will run thicker, if you give it somewhere to gather.&r"
		"&6Field note:&r It boosts the magicule pool and regeneration across a 3x3 chunk area, and burns magic crystals as fuel."
	]
	quest.7131ED4787B854CA.title: "A Hearth for Magicules"
	quest.74898F75C8F8C0CA.quest_desc: [
		"&7&oThe first step is only to listen.&r"
		"&6Field note:&r Toggle: +5% magicule regen (+10% mastered). Masters slowly while toggled on. Auto-learned once Energy Charge is mastered and Haki is acquired."
	]
	quest.74898F75C8F8C0CA.title: "Magicule Attunement"
	quest.751EA452C578CC27.quest_desc: ["&7&oA thing can be kept, if the stone is willing.&r"]
	quest.751EA452C578CC27.title: "Stones That Hold"
	quest.792FA05F6151117B.quest_desc: [
		"&7&oA joke too large to tell, and a chain that finally breaks.&r"
		"&6Field note:&r Ultimate awakening of Imprisoned Jester. In-slot: +50%% physical/magic damage, +30%% crit chance for +100%% crit. Toggle: 25%% reflect on all incoming damage; The Bit Goes On — fatal hits become 5s of invulnerable invisibility..."
	]
	quest.792FA05F6151117B.title: "The Unbound Jester"
	quest.7C3E93891147F6E1.quest_desc: [
		"&7&oThe end of waiting.&r"
		"&6Field note:&r Hold: regen 10% max magicule/s (15% mastered) at the cost of 2% max aura/s. Auto-learned at 100,000 EP once Energy Charge is mastered."
	]
	quest.7C3E93891147F6E1.title: "Maximum Charge"
	quest.7D2CA5E1EBBFEC76.quest_desc: [
		"&7&oWhat was kept in stones now keeps you.&r"
		"&6Field note:&r Ultimate awakening of Sealer. Passive: every kill grants +0.5 Max Spiritual HP, capped at +20,000. Modes: Seal (capture mob into stone if 1.5x stronger), Suppress (seal 20% of self or sneak-target's Max EP into a stone),..."
	]
	quest.7D2CA5E1EBBFEC76.title: "The One Who Seals"
	task.012CC6F80092240B.title: "Be recognised as a True Demon Lord"
	task.02E368C032FC29E9.title: "Awaken as an evil majin"
	task.09D9EE4E80EB8B76.title: "Learn to feed on magicule"
