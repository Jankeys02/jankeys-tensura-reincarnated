	task.5C280CB0615239B0.title: "Uncraft an uncrafting table"
	task.602B24D28E876596.title: "Reach the glacier"
	task.62489BCF842059CD.title: "Eat what the maze's master leaves behind"
	task.62BC0BDDB5212048.title: "Touch the tears"
	task.62C72B4BFD6B5DA1.title: "Dye a piece of arctic armour"
	task.632F9D451F100979.title: "Clear a large hollow hill"
	task.6A3ADCE8C4BA0C5F.title: "Clear a medium hollow hill"
	task.6A753C12FF828120.title: "Give the ram what it is missing"
	task.6B0745C6CA8E72B0.title: "Face the three together"
	task.6F02CD2DE6DB5DA1.title: "Silence the keeper of the tower"
	task.6F16E246B28BA577.title: "Defeat the giant in the clouds"
	task.7188DF936FDE2D3F.title: "Grow the beanstalk"
	task.71AE40E48848AA14.title: "Find the cave"
	task.72027E1434E0D066.title: "Claim your title at the pedestal"
	task.72E836E1B152A8A0.title: "Find the lair"
	task.7E8A9A12A4346B3B.title: "Clear a spider from the hedge maze"
	chapter.7285813B5FC0F5DA.title: "Eternal Starlight"
	quest.04B5958BE5E1D90C.quest_desc: [
		"&7&oA small thing that sings with its whole body. Feed it, and it will stay.&r"
		"&6Field note:&r Tame a crystallized moth with enough meat."
	]
	quest.04B5958BE5E1D90C.title: "Lost in the Echo"
	quest.08C0CB601FCB2803.quest_desc: ["&7&oSome bombs are made of grief.&r"]
	quest.08C0CB601FCB2803.title: "Whoever May Cry"
	quest.09F029A4668C4D5A.quest_desc: [
		"&7&oSomething hungry, something loyal for a day, for the right bowl.&r"
		"&6Field note:&r A bowl of pungency stew buys you one day of service."
	]
	quest.09F029A4668C4D5A.title: "A Hired Hand"
	quest.0E19373703E2EE18.quest_desc: [
		"&7&oA tooth that does not stop wanting, and a blade made to match.&r"
		"&6Field note:&r A thirst walker drops the tooth when it dies or when you block its attack."
	]
	quest.0E19373703E2EE18.title: "Insatiable"
	quest.13B3E0BD61AB4D76.quest_desc: ["&7&oNot every egg is meant to hatch.&r"]
	quest.13B3E0BD61AB4D76.title: "A Bad Egg"
	quest.15D54BB2989642EE.quest_desc: [
		"&7&oEverything that was built has a place it was never meant to be hit.&r"
		"&6Field note:&r A frozen tube thrown at the guardian speeds up its charge. Deactivate the energy block to make it vulnerable."
	]
	quest.15D54BB2989642EE.title: "Weak Points"
	quest.17DD4B5EB132E6F9.quest_desc: ["&7&oSomething lunar and hungry and very, very old.&r"]
	quest.17DD4B5EB132E6F9.title: "Through the Thorns"
	quest.1C030690B33795B0.quest_desc: ["&7&oA face for a dangerous trade.&r"]
	quest.1C030690B33795B0.title: "Final Masquerade"
	quest.1D9E3EA8A230AE23.quest_desc: ["&7&oIt has stood since before the stars were named.&r"]
	quest.1D9E3EA8A230AE23.title: "Ancient Wisdom"
	quest.1F67D3A51542C939.quest_desc: ["&7&oYou have walked every sky this world has.&r"]
	quest.1F67D3A51542C939.title: "Starlight Explorer"
	quest.2221A7F91B6B4F4A.quest_desc: ["&7&oArmour woven from what cannot be seen.&r"]
	quest.2221A7F91B6B4F4A.title: "Stepping into the Unseen"
	quest.26A29F77D295B308.quest_desc: [
		"&7&oSome tools reward a perfectly timed blow.&r"
		"&6Field note:&r Wait for full attack strength and land a critical hit to trigger the hammer special."
	]
	quest.26A29F77D295B308.title: "The Hammer of Justice"
	quest.2ACF076FE50B063F.quest_desc: [
		"&7&oSome crystals only form where the water is not water.&r"
		"&6Field note:&r Thioquartz grows in the ether."
	]
	quest.2ACF076FE50B063F.title: "Poorly Ether-Soluble"
	quest.2E2C0DA1DBC35F54.quest_desc: ["&7&oA thing of thorns, and thorns burn.&r"]
	quest.2E2C0DA1DBC35F54.title: "Burn It to the Ground"
	quest.2E7896563F9F3F4F.quest_desc: ["&7&oA red flower at the bottom of the sea.&r"]
	quest.2E7896563F9F3F4F.title: "Abyssal Romance"
	quest.3098180630BA7365.quest_desc: ["&7&oSome nights, the sky lets go.&r"]
	quest.3098180630BA7365.title: "Wish upon a Star"
	quest.33C6EDEBE21BF0E4.quest_desc: ["&7&oA harvest tool for a stranger kind of harvest.&r"]
	quest.33C6EDEBE21BF0E4.title: "Chaos, Chaos"
	quest.3454D37AA55CD09A.quest_desc: ["&7&oThe sky leaves its own jewels.&r"]
	quest.3454D37AA55CD09A.title: "Ooo! Shiny!"
	quest.358BB4D6CE43DEAC.quest_desc: ["&7&oTo a thinker.&r"]
	quest.358BB4D6CE43DEAC.title: "Swinging in the Boundless Milky Way"
	quest.35A02CEE1A1B57F3.quest_desc: ["&7&oA bright thing, kept where nothing bright should be.&r"]
	quest.35A02CEE1A1B57F3.title: "Unstained in the Mud"
	quest.39094F137549525E.quest_desc: ["&7&oWatch the hunters from a respectful distance.&r"]
	quest.39094F137549525E.title: "Even Death May Die"
	quest.390CFA63DB48F70A.quest_desc: [
		"&7&oA ruined frame waits in the old places, for something that remembers the way.&r"
		"&6Field note:&r Look for portal ruins in the overworld. The Orb of Prophecy opens the frame."
	]
	quest.390CFA63DB48F70A.title: "The Deep Magic"
	quest.44F64672D59BE71C.quest_desc: [
		"&7&oThere are mushrooms that let you go where walls are a suggestion.&r"
		"&6Field note:&r Bouldershroom stew lets you climb anywhere."
	]
	quest.44F64672D59BE71C.title: "Nimble as a Squirrel"
	quest.4AF55801228F0107.quest_desc: [
		"&7&oThe light here has opinions about where you should go.&r"
		"&6Field note:&r A Seeking Eye helps you find places in this world."
	]
	quest.4AF55801228F0107.title: "Guided by Starlight"
	quest.4E86E4AB254A2B21.quest_desc: [
		"&7&oEven trees keep their jewels under the skin.&r"
		"&6Field note:&r Strip torreya logs."
	]
	quest.4E86E4AB254A2B21.title: "Fastidious"
	quest.505C6A557749939B.quest_desc: ["&7&oDoors can have their own opinions about who passes.&r"]
	quest.505C6A557749939B.title: "Duke It Out"
	quest.50A71C319DD54D0F.quest_desc: [
		"&7&oEven fire-birds need help raising their young.&r"
		"&6Field note:&r Put seeds into starfire bird nests until the birds breed."
	]
	quest.50A71C319DD54D0F.title: "Nurturing Roots"
	quest.50C1E7F5648404DD.quest_desc: ["&7&oThe cold has a heart, and it is not kind.&r"]
	quest.50C1E7F5648404DD.title: "Winter Is Leaving"
	quest.573B803BA2DAB5B3.quest_desc: [
		"&7&oBeneath the white, there is a darker white.&r"
		"&6Field note:&r Enter the Ashen Snow layer of the permafrost forest."
	]
	quest.573B803BA2DAB5B3.title: "Under the Permafrost"
	quest.6392133EA3B5A719.quest_desc: [
		"&7&oSomething from above, summoned on purpose.&r"
		"&6Field note:&r Put a carved lunaris cactus fruit on an aethersent block."
	]
	quest.6392133EA3B5A719.title: "Planetary Protection Policy"
	quest.63BD2FC33D76A55A.quest_desc: [
		"&7&oAntlers like frozen branches. Persuade them to come loose.&r"
		"&6Field note:&r Anger an aurora deer and make it charge into hard blocks; its antlers fall off."
	]
	quest.63BD2FC33D76A55A.title: "Asking for Trouble"
	quest.669FDC12161078F9.quest_desc: [
		"&7&oStone wakes when it is given a reason.&r"
		"&6Field note:&r Put a carved lunaris cactus fruit on a grimstone brick."
	]
	quest.669FDC12161078F9.title: "Item Slate"
	quest.6AD9C7F1152CD17A.quest_desc: ["&7&oAt the bottom of the sea there is a second night.&r"]
	quest.6AD9C7F1152CD17A.title: "The Mariana Trench"
	quest.70DA6BB1A66C7C26.quest_desc: ["&7&oStep through, and the ceiling of the world is gone.&r"]
	quest.70DA6BB1A66C7C26.title: "Sky of a Million Stars"
	quest.738C58AB9519C49C.quest_desc: ["&7&oOne explosion, two ends.&r"]
	quest.738C58AB9519C49C.title: "It's Just Friendly Fire"
	quest.786609E020CE3DA1.quest_desc: ["&7&oWhere the stone things are made, the air hums.&r"]
	quest.786609E020CE3DA1.title: "Cradle of Legion"
	quest.79DBCB7C7E43FC71.quest_desc: ["&7&oCold, kept in a stone.&r"]
