	chapter.4FCA00F7666AD6C9.title: "Chrono Dawn"
	quest.00E2A1213B98A25A.quest_desc: ["&7&oNot everything here was built by the same hands.&r"]
	quest.00E2A1213B98A25A.title: "Older Than the Frost"
	quest.023EDD8E15E20B9D.quest_desc: ["&7&oThe last thing time will ever take.&r"]
	quest.023EDD8E15E20B9D.title: "Entropy's End"
	quest.05B6B01414F6527C.quest_desc: ["&7&oEven ghosts keep a house.&r"]
	quest.05B6B01414F6527C.title: "Where the Phantoms Sleep"
	quest.062F428F96FE8871.quest_desc: ["&7&oA vast mechanism, patient and quiet, and wrong.&r"]
	quest.062F428F96FE8871.title: "The Heart of Time"
	quest.098F3FCE6AC7B264.quest_desc: ["&7&oThe key to the heart of time is held by the one who guards it.&r"]
	quest.098F3FCE6AC7B264.title: "Vanquisher of the Guardian"
	quest.10EBACBA2010C728.quest_desc: ["&7&oIt is very large, and it does not get tired.&r"]
	quest.10EBACBA2010C728.title: "Colossus Conqueror"
	quest.110C9C18356E1379.quest_desc: ["&7&oWhat is left of a stopped clock, remade.&r"]
	quest.110C9C18356E1379.title: "Master of Time"
	quest.13C046BE873121A2.quest_desc: ["&7&oIt has been holding the world still. Let go.&r"]
	quest.13C046BE873121A2.title: "Liberator of Chrono Dawn"
	quest.15059AAE9703C15C.quest_desc: [
		"&7&oOn the other side, the world is holding its breath.&r"
		"&6Field note:&r The first trip is one-way. A place called the Forgotten Library explains the way home."
	]
	quest.15059AAE9703C15C.title: "Entering the Frozen World"
	quest.17A85CAD7C3D88A8.quest_desc: ["&7&oEven hours can be mined, if you are patient and strike true.&r"]
	quest.17A85CAD7C3D88A8.title: "Crystallized Time"
	quest.1D17B2A3314FC697.quest_desc: ["&7&oTo bend a moment, you need the right grip.&r"]
	quest.1D17B2A3314FC697.title: "Tools of Temporal Control"
	quest.26F2CB69B4099FF8.quest_desc: [
		"&7&oTime can be held, if you have the right glass and the patience to build a frame for it.&r"
		"&6Field note:&r Obtain a Time Hourglass, build a frame of Clockstone Blocks, and ignite it."
	]
	quest.26F2CB69B4099FF8.title: "A Gateway Through Time"
	quest.32B6B7B8D7A66AF7.quest_desc: ["&7&oArmour made of kept moments.&r"]
	quest.32B6B7B8D7A66AF7.title: "Preserved in Amber"
	quest.344B299B2D7CD2A9.quest_desc: ["&7&oThe ones who were never quite here.&r"]
	quest.344B299B2D7CD2A9.title: "Phantom Banisher"
	quest.34F0254EE89F60C7.quest_desc: ["&7&oA tower of gears in the desert. Something inside is still counting.&r"]
	quest.34F0254EE89F60C7.title: "The Clockwork Spire"
	quest.390C8D234D50C817.quest_desc: ["&7&oThe works under the works.&r"]
	quest.390C8D234D50C817.title: "Below the Gears"
	quest.3FCECB362E3ACC16.quest_desc: ["&7&oEven here, there is trade. Everything is priced in what you cannot get back.&r"]
	quest.3FCECB362E3ACC16.title: "Temporal Merchant"
	quest.4F04AD1D8E30A067.quest_desc: ["&7&oA moment, kept whole, in resin.&r"]
	quest.4F04AD1D8E30A067.title: "Sealed in Time"
	quest.51AE765F20102DBB.quest_desc: ["&7&oArmour that ticks when you breathe.&r"]
	quest.51AE765F20102DBB.title: "Clockwork Warrior"
	quest.5A8D17DAF85EB156.quest_desc: [
		"&7&oFour hard-won pieces of four hard-won things. Together, they are a question.&r"
		"&6Field note:&r Prepare for the battle that ends the second act."
	]
	quest.5A8D17DAF85EB156.title: "Temporal Armament"
	quest.5C692C92661D593F.quest_desc: ["&7&oSomething thin and cold between one second and the next.&r"]
	quest.5C692C92661D593F.title: "Wraith Hunter"
	quest.60038337C4D7FE44.quest_desc: ["&7&oBetter metal, better armour, the same quiet menace.&r"]
	quest.60038337C4D7FE44.title: "Enhanced Temporal Armor"
	quest.6204C87E8D78BAB0.quest_desc: ["&7&oWhere time wears away, something sharp remains.&r"]
	quest.6204C87E8D78BAB0.title: "The Eroder of Time"
	quest.625001FFCEFE67CB.quest_desc: ["&7&oWhere things go when they are forgotten.&r"]
	quest.625001FFCEFE67CB.title: "A Crypt of Quiet Loss"
	quest.6802A04EA8163483.quest_desc: ["&7&oThe fruit here tastes like a Tuesday you forgot.&r"]
	quest.6802A04EA8163483.title: "Taste of Time"
	quest.6C192E6032FA5513.quest_desc: ["&7&oWarden of a place that has no reason to be guarded.&r"]
	quest.6C192E6032FA5513.title: "Guardian Slayer"
	quest.6F6675719C5254B2.quest_desc: [
		"&7&oA kitchen at the edge of everything.&r"
		"&6Field note:&r Time Fruit, Time Fruit Pie, Time Jam and Time Bread."
	]
	quest.6F6675719C5254B2.title: "Gourmet of Time"
	quest.7276C895F40D043A.quest_desc: [
		"&7&oA door that only opens one way is a trap. Make it honest.&r"
		"&6Field note:&r Use the Portal Stabilizer on the frame to travel both ways."
	]
	quest.7276C895F40D043A.title: "Anchoring Time"
	quest.750B1FFAE6E61CC1.quest_desc: ["&7&oSomeone wrote down how to leave. Find where they left the pages.&r"]
	quest.750B1FFAE6E61CC1.title: "What the Library Remembers"
	quest.7D083C72866DC955.quest_desc: ["&7&oBrass and patience. Find the weak joint.&r"]
	quest.7D083C72866DC955.title: "Mechanism Breaker"
	quest.7D24374831ADB55E.quest_desc: ["&7&oBroken moments are still moments.&r"]
	quest.7D24374831ADB55E.title: "Fractured Time"
