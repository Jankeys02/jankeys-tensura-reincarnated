	chapter.36CF90A4CB7F3E74.title: "Cooking and Farming"
	quest.00C7BCB88E9B6C64.quest_desc: ["&7&oSome grains like wet feet.&r"]
	quest.00C7BCB88E9B6C64.title: "Dipping Your Roots"
	quest.021AC20AD6585FA8.quest_desc: ["&7&oA rotten tomato, well aimed, at the right audience.&r"]
	quest.021AC20AD6585FA8.title: "Boo! Hiss!"
	quest.064B46E5BD7C512F.quest_desc: ["&7&oA knife, upgraded with something that survived fire.&r"]
	quest.064B46E5BD7C512F.title: "If You Can't Take the Heat..."
	quest.06BD0F47597C506B.quest_desc: ["&7&oA knife through the stalks, and something useful falls.&r"]
	quest.06BD0F47597C506B.title: "Grasping at Straws"
	quest.07683FEE6B18647B.quest_desc: [
		"&7&oA rope, a little help, and the tomatoes remember how to climb.&r"
		"&6Field note:&r Hang rope above a tomato crop to make it grow taller."
	]
	quest.07683FEE6B18647B.title: "Tall-mato"
	quest.0A4713769F9CB6AB.quest_desc: [
		"&7&oA knife does more than cut bread.&r"
		"&6Field note:&r Use a knife on pigs or hoglins."
	]
	quest.0A4713769F9CB6AB.title: "Wild Butcher"
	quest.12FD497FB2FB3BCC.quest_desc: ["&7&oNot everything good comes in a single bite.&r"]
	quest.12FD497FB2FB3BCC.title: "A Proper Meal"
	quest.1F2B240C4A000535.quest_desc: ["&7&oA pot on the fire, and the house begins to smell like a home.&r"]
	quest.1F2B240C4A000535.title: "Dinner's Served"
	quest.2C6389090D92A12E.quest_desc: [
		"&7&oA pan travels better than a stove.&r"
		"&6Field note:&r Sneak to place the skillet as a block. Or stand near heat and hold food in your other hand."
	]
	quest.2C6389090D92A12E.title: "Sizzling Hot"
	quest.3B86851E3DC0E92A.quest_desc: [
		"&7&oMushrooms are patient and fussy. Give them the best.&r"
		"&6Field note:&r Shear a fully mature colony. They need very rich soil to grow this large."
	]
	quest.3B86851E3DC0E92A.title: "Fungus Among Us"
	quest.430E4E88E9BD2C64.quest_desc: ["&7&oA day in the fields, a basket to show for it.&r"]
	quest.430E4E88E9BD2C64.title: "A Full Basket"
	quest.51CF6F13E709AF6D.quest_desc: ["&7&oEvery green thing that can be eaten, grown by your own hand.&r"]
	quest.51CF6F13E709AF6D.title: "Crop Rotation"
	quest.5228B58600DA7C43.quest_desc: [
		"&7&oSome dishes are too big for one plate, and too good for one person.&r"
		"&6Field note:&r Some meals can be placed down and shared."
	]
	quest.5228B58600DA7C43.title: "A Glorious Feast"
	quest.52C6F953DD3A2AAC.quest_desc: ["&7&oNow we are getting somewhere.&r"]
	quest.52C6F953DD3A2AAC.title: "Hearty Dishes"
	quest.5BF21AB4DA53B8AC.quest_desc: ["&7&oA well-fed hero is a long-lived hero.&r"]
	quest.5BF21AB4DA53B8AC.title: "Nourishing!"
	quest.61C0E3D08C7FCD33.quest_desc: [
		"&7&oGood food grows wild, if you know where to look.&r"
		"&6Field note:&r Four new crops grow in the wild across many climates, or sit in chests."
	]
	quest.61C0E3D08C7FCD33.title: "Crops of the Wild"
	quest.64662BFC3669BEE0.quest_desc: [
		"&7&oA board, a blade, and a little patience.&r"
		"&6Field note:&r Hold a tool and use the cutting board on an item."
	]
	quest.64662BFC3669BEE0.title: "Watch Your Fingers"
	quest.65B67D9BF0E005AC.quest_desc: ["&7&oFire is the oldest recipe.&r"]
	quest.65B67D9BF0E005AC.title: "Bonfire Lit"
	quest.70579FA5622D01A7.quest_desc: ["&7&oEvery course. Every dish. Every kind of fed.&r"]
	quest.70579FA5622D01A7.title: "Master Chef"
	quest.74320A2D430FF576.quest_desc: [
		"&7&oEvery kitchen starts with a sharp edge.&r"
		"&6Field note:&r A knife scavenges extra goods from plants and animals."
	]
	quest.74320A2D430FF576.title: "Hunt and Gather"
	quest.7FFDE734B9777187.quest_desc: [
		"&7&oSomething that was waste is about to become wealth.&r"
		"&6Field note:&r Compost breaks down faster with sun, water and mushrooms, and slowly becomes rich soil."
	]
	quest.7FFDE734B9777187.title: "Advanced Composting"
