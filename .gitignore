# whitelist: only pack source is tracked; mods/saves/logs/account data never are
/*
!/.gitignore
!/.github/
!/config/
!/defaultconfigs/
!/kubejs/
!/server/
!/packwiz/
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/PACK_DESCRIPTION.md
!/README.md
!/SERVER_PACK.md
!/SERVER_HOSTING.md
!/RELEASE_GUIDE.md
!/SECURITY.md
!/package.json
!/DEVELOPMENT.md

# personal / runtime data
/config/jei/world/
/config/spark/

# personal client settings (graphics/UI/minimap prefs), not pack content
/config/DistantHorizons.toml
/config/entity_model_features.json
/config/ftbchunks-client.snbt
/config/ftblibrary-client.snbt
/config/iris.properties
/config/jei/client
/config/pingtomapxaeros-client.toml
/config/sodium-options.json
/config/yacl.json5
/config/sound_physics_remastered/sound_rates.properties
*.bak
*.toml_backup*
