# whitelist: only pack source is tracked; mods/saves/logs/account data never are
/*
!/.gitignore
!/.github/
!/config/
!/defaultconfigs/
!/kubejs/
!/packwiz/
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/LICENSE
!/PACK_DESCRIPTION.md
!/README.md
!/SERVER_PACK.md
!/SERVER_HOSTING.md
!/client-mods-to-exclude.txt
!/RELEASE_GUIDE.md
!/SECURITY.md
!/package.json
!/DEVELOPMENT.md
!/MODS.md
!/tools/
/tools/*
!/tools/modlist.js

# personal / runtime data
/config/jei/world/
/config/spark/
